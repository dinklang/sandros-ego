# Copy this rule into a `.rules` file under `~/.codex/rules/`.
# Replace /ABSOLUTE/HOME with the absolute home directory on this machine.
# Keep the absolute executable path. A rule for bare `ego` could match another
# executable earlier in PATH, and a broad `tmux` rule would permit tmux run-shell.
# `forget` is left out on purpose: `forget --purge` removes a record, so the
# controller should ask before running it; `purge` is left out for the same
# reason. `promote` is left out because widening scope lets the controller act
# on another controller's workspace; `scope` is allowed because Ego only lets a
# controller narrow its own scope.
prefix_rule(
    pattern=[
        "/ABSOLUTE/HOME/.ego/bin/ego",
        [
            "session-start",
            "scan",
            "list",
            "controllers",
            "context",
            "status",
            "prune",
            "register",
            "spawn",
            "onboard",
            "onboard-workspace",
            "handoff",
            "checkpoint",
            "stow",
            "handoff-workspace",
            "takeback-workspace",
            "recover",
            "peek",
            "send",
            "press",
            "scope",
            "workspaces",
            "retire",
            "inspect",
            "handback",
            "takeback",
            "watch",
            "reset",
            "inbox",
            "ack",
            "report",
        ],
    ],
    decision="allow",
    justification="Allow the protected Ego controller to access tmux without granting Codex full access",
)
