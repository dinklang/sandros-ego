#!/usr/bin/env bash
set -eu

SCRIPT_PATH=${BASH_SOURCE[0]}
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR=$(cd "$(dirname "$SCRIPT_PATH")" && pwd)
  LINK_TARGET=$(readlink "$SCRIPT_PATH")
  case "$LINK_TARGET" in
    /*) SCRIPT_PATH=$LINK_TARGET ;;
    *) SCRIPT_PATH="$SCRIPT_DIR/$LINK_TARGET" ;;
  esac
done
SCRIPT_DIR=$(cd "$(dirname "$SCRIPT_PATH")" && pwd)
if [ -f "$SCRIPT_DIR/repo-root" ]; then
  IFS= read -r REPO_ROOT < "$SCRIPT_DIR/repo-root"
else
  REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
fi
# Temporary Codex permission workaround: controller prompts use this protected
# installed copy so a narrow command rule can reach tmux without full access.
EGO_CLI_PATH="$SCRIPT_DIR/ego"
EGO_ROOT=${EGO_ROOT:-$HOME/.ego}
EGO_HOME=${EGO_HOME:-$EGO_ROOT/state}
CONTROLLER_GUIDE=${EGO_CONTROLLER_GUIDE:-$EGO_ROOT/CONTROLLER.md}
AGENTS_DIR="$EGO_HOME/agents"
WORKSPACES_DIR="$EGO_HOME/workspaces"
WORKTREES_DIR="$EGO_HOME/worktrees"
EVENTS_FILE="$EGO_HOME/events.log"

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Sandro's Ego manages agent windows in an existing tmux server.

Usage:
  ego install
  ego init
  ego scan
  ego list
  ego workspaces
  ego context
  ego session-start
  ego register <window|session:window> [--id <id>] [--root <path>]
                         [--agent <type>]
  ego spawn <name> [--session <session>] [--root <path>] [--id <id>]
                         [--brief <text>] [--agent <codex|claude>]
                         [--worktree] [--branch <name>]
                         [--command <shell-command>]
  ego onboard <id>
  ego onboard-workspace <session>
  ego handoff <id|window> [--session <session>] --summary <text> [--next <text>]
  ego checkpoint <session> --summary <text> [--next <text>]
  ego stow <session> --summary <text> [--next <text>]
  ego archive-workspace <session>
  ego handoff-workspace <session> --summary <text> [--next <text>]
  ego takeback-workspace <session>
  ego recover [session]
  ego takeback <id|window> [--session <session>]
  ego peek <id> [lines]
  ego send <id> <message...>
  ego press <id> <enter|escape|y|n|p>
  ego inbox <id>
  ego ack <id> <message-id>
  ego report <id> <working|idle|blocked|needs-decision|done|failed|note> <message...>
  ego watch [seconds] [--all]
  ego start [--session <session>] [--window <name>] [--agent <codex|claude>]

Environment:
  EGO_ROOT          Installation root. Default: ~/.ego
  EGO_HOME          State directory. Default: ~/.ego/state
  EGO_AGENT_NAVIGATOR  Agent Navigator executable. Default: installed helper.
  EGO_TMUX_SOCKET   Optional tmux socket name, useful for isolated servers.
EOF
}

command_usage() {
  case "$1" in
    handoff)
      cat <<'EOF'
Usage: ego handoff <id|window> [--session <session>] --summary <text> [--next <text>]

Give Ego continuing supervision responsibility for one worker. The command
does not restart or steer the worker. --summary is required; --next is optional.
EOF
      ;;
    takeback)
      cat <<'EOF'
Usage: ego takeback <id|window> [--session <session>]

Return supervision responsibility to Sandro. Reporting stays enabled. The
command prints the worker's latest durable report when one exists.
EOF
      ;;
    spawn)
      cat <<'EOF'
Usage: ego spawn <name> [--session <session>] [--root <path>] [--id <id>]
                 [--brief <text>] [--agent <codex|claude>]
                 [--worktree] [--branch <name>] [--command <shell-command>]

Create a tracked worker window. Codex is the default agent. --brief is
optional. Inside tmux, --session is optional and defaults to the current
session. A missing named session is created below @workspace_primary unless
--root is supplied.
EOF
      ;;
    report)
      cat <<'EOF'
Usage: ego report <id> <working|idle|blocked|needs-decision|done|failed|note> <message...>

Append a material worker status update to durable state. Common phase words are
normalized: investigating and validating become working, waiting becomes idle,
complete becomes done, and error becomes failed.
EOF
      ;;
    watch)
      cat <<'EOF'
Usage: ego watch [seconds] [--all]

Wait for an actionable event. The default timeout is 300 seconds. A timeout
prints a quiet-period message and exits successfully. --all also wakes for
routine events.
EOF
      ;;
    press)
      cat <<'EOF'
Usage: ego press <id> <enter|escape|y|n|p>

Send one allowed key to a worker's live terminal UI. Inspect the pane first.
Use this for an explicit interactive prompt, never for a worker instruction.
EOF
      ;;
    *)
      usage
      ;;
  esac
}

cmd_install() {
  local install_dir=${EGO_INSTALL_DIR:-$EGO_ROOT/bin}
  local controller_guide=${EGO_CONTROLLER_GUIDE:-$EGO_ROOT/CONTROLLER.md}
  local root_tmp
  mkdir -p "$install_dir" "$(dirname "$controller_guide")"
  install -m 755 "$REPO_ROOT/bin/ego" "$install_dir/ego"
  install -m 644 "$REPO_ROOT/CONTROLLER.md" "$controller_guide"
  root_tmp=$(mktemp "$install_dir/.repo-root.XXXXXX")
  printf '%s\n' "$REPO_ROOT" > "$root_tmp"
  mv "$root_tmp" "$install_dir/repo-root"
  printf 'installed Ego at %s\n' "$install_dir/ego"
}

tmux_cmd() {
  if [ -n "${EGO_TMUX_SOCKET:-}" ]; then
    command tmux -L "$EGO_TMUX_SOCKET" "$@"
  else
    command tmux "$@"
  fi
}

require_tmux() {
  command -v tmux >/dev/null 2>&1 || die "tmux is not installed"
  tmux_cmd list-sessions >/dev/null 2>&1 || die "no tmux server is running"
}

ensure_home() {
  mkdir -p "$AGENTS_DIR" "$WORKSPACES_DIR" "$WORKTREES_DIR" "$EGO_HOME/controller"
  [ -e "$EVENTS_FILE" ] || : > "$EVENTS_FILE"
}

valid_id() {
  case "$1" in
    ''|.*|*/*|*[!A-Za-z0-9._-]*) return 1 ;;
    *) return 0 ;;
  esac
}

clean_id() {
  printf '%s' "$1" | LC_ALL=C tr -c 'A-Za-z0-9._-' '-'
}

one_line() {
  printf '%s' "$1" | tr '\t\r\n' '   '
}

now() {
  date -u '+%Y-%m-%dT%H:%M:%SZ'
}

shell_quote() {
  printf "'"
  printf '%s' "$1" | sed "s/'/'\\\\''/g"
  printf "'"
}

meta_get() {
  local file=$1 key=$2
  awk -F= -v key="$key" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "$file"
}

meta_set() {
  local file=$1 key=$2 value=$3 tmp
  tmp=$(mktemp "${file}.tmp.XXXXXX")
  awk -F= -v key="$key" -v value="$value" '
    BEGIN { found = 0 }
    $1 == key { print key "=" value; found = 1; next }
    { print }
    END { if (!found) print key "=" value }
  ' "$file" > "$tmp"
  mv "$tmp" "$file"
}

append_event() {
  local kind=$1 id=$2 detail=$3
  ensure_home
  printf '%s\t%s\t%s\t%s\n' "$(now)" "$kind" "$id" "$(one_line "$detail")" >> "$EVENTS_FILE"
}

inventory() {
  local fmt
  fmt=$'#{session_name}\t#{window_name}\t#{window_id}\t#{pane_id}\t#{pane_current_path}\t#{pane_current_command}\t#{session_path}\t#{pane_index}\t#{pane_pid}\t#{pane_tty}'
  tmux_cmd list-panes -a -F "$fmt"
}

resolve_target() {
  local selector=$1 matches session window current=
  if [ -n "${TMUX:-}" ]; then
    current=$(current_tmux_session 2>/dev/null || true)
  fi

  if [[ "$selector" == *:* ]]; then
    session=${selector%%:*}
    window=${selector#*:}
    matches=$(inventory | awk -F '\t' -v s="$session" -v w="$window" '$1 == s && $2 == w')
  elif [ -n "$current" ] && inventory | awk -F '\t' -v s="$current" -v w="$selector" '$1 == s && $2 == w { found=1 } END { exit !found }'; then
    matches=$(inventory | awk -F '\t' -v s="$current" -v w="$selector" '$1 == s && $2 == w')
  else
    matches=$(inventory | awk -F '\t' -v w="$selector" '$2 == w')
  fi

  [ -n "$matches" ] || die "no tmux window matches '$selector'"
  [ "$(printf '%s\n' "$matches" | wc -l | tr -d ' ')" -eq 1 ] \
    || die "more than one tmux window matches '$selector'; use session:window"
  printf '%s\n' "$matches"
}

record_agent() {
  local id=$1 row=$2 root_override=${3:-} owner_override=${4:-} agent_override=${5:-} reporting_override=${6:-}
  local session window window_id pane_id cwd command session_path pane_index pane_pid pane_tty root workspace_root dir meta created owner agent reporting origin tmp
  local existing_root= existing_workspace_root= source_root= worktree= branch=
  IFS=$'\t' read -r session window window_id pane_id cwd command session_path pane_index pane_pid pane_tty <<< "$row"
  valid_id "$id" || die "invalid agent id '$id'"
  dir="$AGENTS_DIR/$id"
  meta="$dir/meta"
  mkdir -p "$dir/inbox"
  created=$(now)
  owner=human
  agent=unknown
  reporting=unknown
  origin=human
  if [ -f "$meta" ]; then
    created=$(meta_get "$meta" created_at)
    owner=$(meta_get "$meta" owner)
    agent=$(meta_get "$meta" agent)
    [ -n "$agent" ] || agent=unknown
    reporting=$(meta_get "$meta" reporting)
    [ -n "$reporting" ] || reporting=unknown
    existing_root=$(meta_get "$meta" root)
    existing_workspace_root=$(meta_get "$meta" workspace_root)
    source_root=$(meta_get "$meta" source_root)
    worktree=$(meta_get "$meta" worktree)
    branch=$(meta_get "$meta" branch)
    origin=$(meta_get "$meta" origin)
    if [ -z "$origin" ]; then
      if [ -f "$dir/launch.sh" ]; then origin=ego; else origin=human; fi
    fi
  fi
  [ -z "$owner_override" ] || owner=$owner_override
  [ -z "$agent_override" ] || agent=$agent_override
  [ -z "$reporting_override" ] || reporting=$reporting_override
  root=${root_override:-$existing_root}
  [ -n "$root" ] || root=$session_path
  [ -n "$root" ] || root=$cwd
  workspace_root=${existing_workspace_root:-$session_path}
  [ -n "$workspace_root" ] || workspace_root=$root
  tmp=$(mktemp "$dir/.meta.XXXXXX")
  {
    printf 'id=%s\n' "$id"
    printf 'session=%s\n' "$session"
    printf 'window=%s\n' "$window"
    printf 'window_id=%s\n' "$window_id"
    printf 'pane_id=%s\n' "$pane_id"
    printf 'pane_index=%s\n' "$pane_index"
    printf 'pane_pid=%s\n' "$pane_pid"
    printf 'pane_tty=%s\n' "$pane_tty"
    printf 'root=%s\n' "$root"
    printf 'workspace_root=%s\n' "$workspace_root"
    [ -z "$source_root" ] || printf 'source_root=%s\n' "$source_root"
    [ -z "$worktree" ] || printf 'worktree=%s\n' "$worktree"
    [ -z "$branch" ] || printf 'branch=%s\n' "$branch"
    printf 'cwd=%s\n' "$cwd"
    printf 'command=%s\n' "$command"
    printf 'agent=%s\n' "$agent"
    printf 'owner=%s\n' "$owner"
    printf 'reporting=%s\n' "$reporting"
    printf 'origin=%s\n' "$origin"
    printf 'active=yes\n'
    printf 'created_at=%s\n' "$created"
    printf 'updated_at=%s\n' "$(now)"
  } > "$tmp"
  mv "$tmp" "$meta"
  printf '%s\n' "$id"
}

register_target() {
  local selector=$1 requested_id=${2:-} root=${3:-} agent=${4:-} row session window id
  row=$(resolve_target "$selector")
  IFS=$'\t' read -r session window _ <<< "$row"
  id=${requested_id:-$(clean_id "$session--$window")}
  record_agent "$id" "$row" "$root" "" "$agent"
}

agent_meta() {
  local id=$1 meta
  meta="$AGENTS_DIR/$id/meta"
  [ -f "$meta" ] || die "unknown agent '$id'; run 'ego scan' or 'ego register' first"
  printf '%s\n' "$meta"
}

agent_id_in_session() {
  local wanted_session=$1 wanted_agent=$2 dir meta found= id session window
  for dir in "$AGENTS_DIR"/*; do
    [ -d "$dir" ] || continue
    meta="$dir/meta"
    [ -f "$meta" ] || continue
    session=$(meta_get "$meta" session)
    [ "$session" = "$wanted_session" ] || continue
    id=$(meta_get "$meta" id)
    window=$(meta_get "$meta" window)
    if [ "$id" = "$wanted_agent" ] || [ "$window" = "$wanted_agent" ]; then
      [ -z "$found" ] || die "more than one agent matches '$wanted_agent' in session '$wanted_session'"
      found=$id
    fi
  done
  [ -n "$found" ] || return 1
  printf '%s\n' "$found"
}

current_tmux_session() {
  [ -n "${TMUX:-}" ] || return 1
  if [ -n "${TMUX_PANE:-}" ]; then
    tmux_cmd display-message -p -t "$TMUX_PANE" '#S' 2>/dev/null
  else
    tmux_cmd display-message -p '#S' 2>/dev/null
  fi
}

valid_agent() {
  case "$1" in codex|claude|gemini|aider|opencode|unknown) return 0 ;; *) return 1 ;; esac
}

expand_workspace_root() {
  local value=$1
  case "$value" in
    '~') printf '%s\n' "$HOME" ;;
    '~/'*) printf '%s/%s\n' "$HOME" "${value#~/}" ;;
    '$HOME') printf '%s\n' "$HOME" ;;
    '$HOME/'*) printf '%s/%s\n' "$HOME" "${value#\$HOME/}" ;;
    *) printf '%s\n' "$value" ;;
  esac
}

workspace_option() {
  local name=$1 value
  value=$(tmux_cmd show-options -gqv "$name" 2>/dev/null || true)
  [ -z "$value" ] || expand_workspace_root "$value"
}

path_within() {
  case "$1" in "$2"|"$2"/*) return 0 ;; *) return 1 ;; esac
}

workspace_kind() {
  local root=$1 primary secondary
  primary=$(workspace_option @workspace_primary)
  secondary=$(workspace_option @workspace_secondary)
  if [ -n "$primary" ] && path_within "$root" "$primary"; then
    printf 'primary\n'
  elif [ -n "$secondary" ] && path_within "$root" "$secondary"; then
    printf 'secondary\n'
  else
    printf 'external\n'
  fi
}

record_workspace() {
  local session=$1 root=$2 id dir tmp
  id=$(clean_id "$session")
  dir="$WORKSPACES_DIR/$id"
  mkdir -p "$dir"
  tmp=$(mktemp "$dir/.meta.XXXXXX")
  {
    printf 'session=%s\n' "$session"
    printf 'root=%s\n' "$root"
    printf 'kind=%s\n' "$(workspace_kind "$root")"
    printf 'state=active\n'
    printf 'updated_at=%s\n' "$(now)"
  } > "$tmp"
  mv "$tmp" "$dir/meta"
}

scan_workspaces() {
  local fmt row session root
  fmt=$'#{session_name}\t#{session_path}'
  while IFS= read -r row; do
    IFS=$'\t' read -r session root <<< "$row"
    if [ ! -d "$root" ]; then
      root=$(recorded_workspace_root "$session" 2>/dev/null || true)
    fi
    if [ ! -d "$root" ]; then
      root=$(inventory | awk -F '\t' -v s="$session" '$1 == s && $5 != "" { print $5; exit }')
    fi
    [ -d "$root" ] || continue
    record_workspace "$session" "$root"
  done < <(tmux_cmd list-sessions -F "$fmt")
}

recorded_workspace_root() {
  local wanted=$1 dir meta root
  for dir in "$WORKSPACES_DIR"/*; do
    [ -d "$dir" ] || continue
    meta="$dir/meta"
    [ -f "$meta" ] || continue
    [ "$(meta_get "$meta" session)" = "$wanted" ] || continue
    root=$(meta_get "$meta" root)
    [ -d "$root" ] || return 1
    printf '%s\n' "$root"
    return 0
  done
  return 1
}

resolve_session_root() {
  local session=$1 root=
  root=$(tmux_cmd display-message -p -t "=$session" '#{session_path}' 2>/dev/null || true)
  if [ -d "$root" ]; then
    printf '%s\n' "$root"
    return 0
  fi
  if root=$(recorded_workspace_root "$session"); then
    printf '%s\n' "$root"
    return 0
  fi
  root=$(inventory | awk -F '\t' -v s="$session" '$1 == s && $5 != "" { print $5; exit }')
  if [ -d "$root" ]; then
    printf '%s\n' "$root"
    return 0
  fi
  return 1
}

pane_snapshot() {
  local pane=$1 fmt
  fmt=$'#{session_name}\t#{window_name}\t#{pane_current_path}\t#{pane_current_command}'
  tmux_cmd display-message -p -t "$pane" "$fmt" 2>/dev/null
}

cmd_init() {
  ensure_home
  printf 'initialized %s\n' "$EGO_HOME"
}

cmd_register() {
  [ $# -ge 1 ] || die "register requires a tmux window"
  local selector=$1 id= root= agent=unknown
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --id) [ $# -ge 2 ] || die "--id requires a value"; id=$2; shift 2 ;;
      --root) [ $# -ge 2 ] || die "--root requires a value"; root=$2; shift 2 ;;
      --agent) [ $# -ge 2 ] || die "--agent requires a value"; agent=$2; shift 2 ;;
      *) die "unknown register option '$1'" ;;
    esac
  done
  valid_agent "$agent" || die "unsupported agent type '$agent'"
  ensure_home
  id=$(register_target "$selector" "$id" "$root" "$agent")
  append_event registered "$id" "$selector"
  printf 'registered %s\n' "$id"
}

agent_navigator_path() {
  local candidate
  if [ -n "${EGO_AGENT_NAVIGATOR:-}" ]; then
    [ -x "$EGO_AGENT_NAVIGATOR" ] || return 1
    printf '%s\n' "$EGO_AGENT_NAVIGATOR"
    return 0
  fi
  for candidate in \
    "$HOME/.local/share/agent-navigator/bin/agent-navigator" \
    "$HOME/Work/tmuxShi/agent-navigator/bin/agent-navigator"; do
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

agent_id_for_pane() {
  local pane=$1 dir meta
  for dir in "$AGENTS_DIR"/*; do
    [ -d "$dir" ] || continue
    meta="$dir/meta"
    [ -f "$meta" ] || continue
    if [ "$(meta_get "$meta" pane_id)" = "$pane" ]; then
      meta_get "$meta" id
      return 0
    fi
  done
  return 1
}

controller_pane() {
  [ -f "$EGO_HOME/controller.meta" ] || return 1
  meta_get "$EGO_HOME/controller.meta" pane_id
}

cmd_scan() {
  require_tmux
  ensure_home
  local all_rows navigator detected row session window pane pane_index id agent observed controller= count=0 dir meta existing_pane
  scan_workspaces
  all_rows=$(inventory)

  for dir in "$AGENTS_DIR"/*; do
    [ -d "$dir" ] || continue
    meta="$dir/meta"
    [ -f "$meta" ] || continue
    existing_pane=$(meta_get "$meta" pane_id)
    row=$(printf '%s\n' "$all_rows" | awk -F '\t' -v p="$existing_pane" '$4 == p { print; exit }')
    [ -n "$row" ] || continue
    id=$(meta_get "$meta" id)
    record_agent "$id" "$row" >/dev/null
  done

  navigator=$(agent_navigator_path) \
    || die "Agent Navigator is not installed; set EGO_AGENT_NAVIGATOR to its executable"
  detected=$("$navigator" list) || die "Agent Navigator could not inspect the tmux server"
  controller=$(controller_pane 2>/dev/null || true)
  while IFS=$'\t' read -r pane agent observed _; do
    [ -n "$pane" ] || continue
    [ "$pane" != "$controller" ] || continue
    row=$(printf '%s\n' "$all_rows" | awk -F '\t' -v p="$pane" '$4 == p { print; exit }')
    [ -n "$row" ] || continue
    IFS=$'\t' read -r session window _ _ _ _ _ pane_index _ <<< "$row"
    if id=$(agent_id_for_pane "$pane"); then
      :
    else
      id=$(clean_id "$session--$window")
      if [ -f "$AGENTS_DIR/$id/meta" ]; then
        id=$(clean_id "$session--$window--p$pane_index")
      fi
    fi
    record_agent "$id" "$row" "" "" "$agent" >/dev/null
    meta="$AGENTS_DIR/$id/meta"
    meta_set "$meta" observed_state "$observed"
    count=$((count + 1))
  done <<< "$detected"
  append_event scan fleet "$count detected agent panes"
  printf 'registered or refreshed %s detected agent panes\n' "$count"
}

cmd_workspaces() {
  ensure_home
  local active_only=${1:-} dir meta state
  printf 'SESSION\tKIND\tROOT\n'
  for dir in "$WORKSPACES_DIR"/*; do
    [ -d "$dir" ] || continue
    meta="$dir/meta"
    [ -f "$meta" ] || continue
    state=$(meta_get "$meta" state)
    [ "$active_only" != active ] || [ "$state" != archived ] || continue
    printf '%s\t%s\t%s\n' "$(meta_get "$meta" session)" "$(meta_get "$meta" kind)" "$(meta_get "$meta" root)"
  done
}

cmd_list() {
  ensure_home
  local active_only=${1:-} dir meta id pane owner reporting origin active session window cwd command agent live
  printf 'ID\tOWNER\tREPORTING\tORIGIN\tSTATE\tAGENT\tTARGET\tCWD\tCOMMAND\n'
  for dir in "$AGENTS_DIR"/*; do
    [ -d "$dir" ] || continue
    meta="$dir/meta"
    [ -f "$meta" ] || continue
    active=$(meta_get "$meta" active)
    [ "$active_only" != active ] || [ "$active" != no ] || continue
    id=$(meta_get "$meta" id)
    pane=$(meta_get "$meta" pane_id)
    owner=$(meta_get "$meta" owner)
    reporting=$(meta_get "$meta" reporting)
    [ -n "$reporting" ] || reporting=unknown
    origin=$(meta_get "$meta" origin)
    [ -n "$origin" ] || origin=human
    agent=$(meta_get "$meta" agent)
    session=$(meta_get "$meta" session)
    window=$(meta_get "$meta" window)
    live=missing
    cwd=$(meta_get "$meta" cwd)
    command=$(meta_get "$meta" command)
    if snap=$(pane_snapshot "$pane"); then
      live=live
      IFS=$'\t' read -r _ _ cwd command <<< "$snap"
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s:%s\t%s\t%s\n' "$id" "$owner" "$reporting" "$origin" "$live" "$agent" "$session" "$window" "$cwd" "$command"
  done
}

cmd_context() {
  ensure_home
  printf '# Sandro\x27s Ego context\n\nGenerated: %s\n\n' "$(now)"
  printf '## Workspaces\n\n'
  cmd_workspaces active
  local workspace_dir checkpoint
  for workspace_dir in "$WORKSPACES_DIR"/*; do
    [ -d "$workspace_dir" ] || continue
    checkpoint="$workspace_dir/checkpoint.md"
    [ -f "$checkpoint" ] || continue
    printf '\n'
    cat "$checkpoint"
  done
  printf '\n## Agents\n\n'
  cmd_list active
  local dir meta id owner reporting active handoff status
  for dir in "$AGENTS_DIR"/*; do
    [ -d "$dir" ] || continue
    meta="$dir/meta"
    [ -f "$meta" ] || continue
    active=$(meta_get "$meta" active)
    [ "$active" != no ] || continue
    id=$(meta_get "$meta" id)
    owner=$(meta_get "$meta" owner)
    reporting=$(meta_get "$meta" reporting)
    [ -n "$reporting" ] || reporting=unknown
    handoff="$dir/handoff.md"
    status="$dir/status.log"
    [ "$owner" = ego ] || [ -f "$status" ] || [ -f "$handoff" ] || continue
    printf '\n## Tracked agent: %s\n\n' "$id"
    printf 'Owner: %s\nReporting: %s\n' "$owner" "$reporting"
    if [ "$owner" = ego ] && [ -f "$handoff" ]; then
      printf '\n'
      sed -n '1,160p' "$handoff"
    fi
    if [ -f "$status" ]; then
      printf '\nRecent status:\n'
      tail -n 5 "$status"
    fi
  done
}

cmd_session_start() {
  require_tmux
  cmd_scan >/dev/null
  cmd_context
}

write_workspace_checkpoint() {
  local session=$1 summary=$2 next=$3 mode=$4 id dir meta
  id=$(clean_id "$session")
  dir="$WORKSPACES_DIR/$id"
  meta="$dir/meta"
  [ -f "$meta" ] || die "unknown workspace '$session'; run 'ego scan' first"
  {
    printf '# Workspace checkpoint\n\n'
    printf 'Session: %s\n' "$session"
    printf 'Root: %s\n' "$(meta_get "$meta" root)"
    printf 'Kind: %s\n' "$(meta_get "$meta" kind)"
    printf 'Updated: %s\n' "$(now)"
    printf 'Mode: %s\n\n' "$mode"
    printf '## Current state\n\n%s\n' "$summary"
    if [ -n "$next" ]; then
      printf '\n## Next action\n\n%s\n' "$next"
    fi
  } > "$dir/checkpoint.md"
}

parse_workspace_note() {
  WORKSPACE_SESSION=${1:-}
  [ -n "$WORKSPACE_SESSION" ] || die "$WORKSPACE_ACTION requires a session"
  shift
  WORKSPACE_SUMMARY=
  WORKSPACE_NEXT=
  while [ $# -gt 0 ]; do
    case "$1" in
      --summary) [ $# -ge 2 ] || die "--summary requires text"; WORKSPACE_SUMMARY=$2; shift 2 ;;
      --next) [ $# -ge 2 ] || die "--next requires text"; WORKSPACE_NEXT=$2; shift 2 ;;
      *) die "unknown $WORKSPACE_ACTION option '$1'" ;;
    esac
  done
  [ -n "$WORKSPACE_SUMMARY" ] || die "$WORKSPACE_ACTION requires --summary"
}

cmd_checkpoint() {
  WORKSPACE_ACTION=checkpoint
  parse_workspace_note "$@"
  scan_workspaces
  write_workspace_checkpoint "$WORKSPACE_SESSION" "$WORKSPACE_SUMMARY" "$WORKSPACE_NEXT" checkpoint
  append_event checkpoint "$WORKSPACE_SESSION" "$WORKSPACE_SUMMARY"
  printf 'checkpointed workspace %s\n' "$WORKSPACE_SESSION"
}

cmd_stow() {
  WORKSPACE_ACTION=stow
  parse_workspace_note "$@"
  scan_workspaces
  write_workspace_checkpoint "$WORKSPACE_SESSION" "$WORKSPACE_SUMMARY" "$WORKSPACE_NEXT" stow
  append_event stow "$WORKSPACE_SESSION" "$WORKSPACE_SUMMARY"
  printf 'stowed workspace %s\n' "$WORKSPACE_SESSION"
}

cmd_archive_workspace() {
  [ $# -eq 1 ] || die "archive-workspace requires one session"
  ensure_home
  local session=$1 workspace_id workspace_dir meta stamp archive_file dir agent_meta_file count=0
  workspace_id=$(clean_id "$session")
  workspace_dir="$WORKSPACES_DIR/$workspace_id"
  meta="$workspace_dir/meta"
  [ -f "$meta" ] || die "unknown workspace '$session'"
  stamp=$(date -u '+%Y%m%dT%H%M%SZ')
  mkdir -p "$workspace_dir/archive"
  if [ -f "$workspace_dir/checkpoint.md" ]; then
    archive_file="$workspace_dir/archive/$stamp.md"
    mv "$workspace_dir/checkpoint.md" "$archive_file"
  fi
  meta_set "$meta" state archived
  meta_set "$meta" archived_at "$(now)"
  for dir in "$AGENTS_DIR"/*; do
    [ -d "$dir" ] || continue
    agent_meta_file="$dir/meta"
    [ -f "$agent_meta_file" ] || continue
    [ "$(meta_get "$agent_meta_file" session)" = "$session" ] || continue
    meta_set "$agent_meta_file" owner human
    meta_set "$agent_meta_file" active no
    meta_set "$agent_meta_file" updated_at "$(now)"
    count=$((count + 1))
  done
  append_event workspace-archived "$session" "$count agent records hidden from startup context"
  printf 'archived workspace %s and %s agent records from active context\n' "$session" "$count"
}

cmd_handoff_workspace() {
  WORKSPACE_ACTION=handoff-workspace
  parse_workspace_note "$@"
  cmd_scan >/dev/null
  write_workspace_checkpoint "$WORKSPACE_SESSION" "$WORKSPACE_SUMMARY" "$WORKSPACE_NEXT" handoff
  local dir meta session count=0
  for dir in "$AGENTS_DIR"/*; do
    [ -d "$dir" ] || continue
    meta="$dir/meta"
    [ -f "$meta" ] || continue
    session=$(meta_get "$meta" session)
    [ "$session" = "$WORKSPACE_SESSION" ] || continue
    [ "$(meta_get "$meta" active)" != no ] || continue
    meta_set "$meta" owner ego
    meta_set "$meta" updated_at "$(now)"
    count=$((count + 1))
  done
  append_event workspace-handoff "$WORKSPACE_SESSION" "$WORKSPACE_SUMMARY"
  printf 'handed workspace %s and %s registered agents to Ego\n' "$WORKSPACE_SESSION" "$count"
}

cmd_recover() {
  ensure_home
  local wanted=${1:-} dir meta session checkpoint archived_checkpoint found=0 tmux_available=0
  if command -v tmux >/dev/null 2>&1 && tmux_cmd list-sessions >/dev/null 2>&1; then
    tmux_available=1
  fi
  printf '# Recovery view\n\n'
  for dir in "$WORKSPACES_DIR"/*; do
    [ -d "$dir" ] || continue
    meta="$dir/meta"
    [ -f "$meta" ] || continue
    session=$(meta_get "$meta" session)
    [ -z "$wanted" ] || [ "$wanted" = "$session" ] || continue
    found=1
    printf '## %s\n\n' "$session"
    cat "$meta"
    checkpoint="$dir/checkpoint.md"
    if [ -f "$checkpoint" ]; then
      printf '\n'
      cat "$checkpoint"
    else
      archived_checkpoint=$(find "$dir/archive" -type f -name '*.md' 2>/dev/null | LC_ALL=C sort | tail -n 1)
      if [ -n "$archived_checkpoint" ]; then
        printf '\nLatest archived checkpoint:\n\n'
        cat "$archived_checkpoint"
      else
        printf '\nNo workspace checkpoint has been written.\n'
      fi
    fi
    printf '\nAgents in this workspace:\n'
    local agent_dir agent_meta_file pane endpoint
    for agent_dir in "$AGENTS_DIR"/*; do
      [ -d "$agent_dir" ] || continue
      agent_meta_file="$agent_dir/meta"
      [ -f "$agent_meta_file" ] || continue
      [ "$(meta_get "$agent_meta_file" session)" = "$session" ] || continue
      pane=$(meta_get "$agent_meta_file" pane_id)
      endpoint=unavailable
      if [ "$tmux_available" -eq 1 ]; then
        if pane_snapshot "$pane" >/dev/null; then endpoint=live; else endpoint=missing; fi
      fi
      printf '%s owner=%s agent=%s window=%s endpoint=%s\n' \
        "$(meta_get "$agent_meta_file" id)" "$(meta_get "$agent_meta_file" owner)" \
        "$(meta_get "$agent_meta_file" agent)" "$(meta_get "$agent_meta_file" window)" "$endpoint"
    done
    printf '\n'
  done
  [ "$found" -eq 1 ] || die "no recorded workspace matches '${wanted:-any session}'"
}

cmd_handoff() {
  local ref= session= summary= next= id meta dir
  while [ $# -gt 0 ]; do
    case "$1" in
      --session) [ $# -ge 2 ] || die "--session requires a value"; session=$2; shift 2 ;;
      --summary) [ $# -ge 2 ] || die "--summary requires text"; summary=$2; shift 2 ;;
      --next) [ $# -ge 2 ] || die "--next requires text"; next=$2; shift 2 ;;
      --*) die "unknown handoff option '$1'" ;;
      *) [ -z "$ref" ] || die "handoff accepts one agent or window"; ref=$1; shift ;;
    esac
  done
  [ -n "$ref" ] || die "handoff requires an agent id or tmux window"
  [ -n "$summary" ] || die "handoff requires --summary"
  ensure_home
  if [ -n "$session" ]; then
    if id=$(agent_id_in_session "$session" "$ref"); then
      :
    else
      id=$(register_target "$session:$ref")
    fi
  elif [ -f "$AGENTS_DIR/$ref/meta" ]; then
    id=$ref
  else
    id=$(register_target "$ref")
  fi
  meta=$(agent_meta "$id")
  dir=${meta%/meta}
  {
    printf '# Handoff\n\n'
    printf 'Updated: %s\n\n' "$(now)"
    printf '## Current state\n\n%s\n' "$summary"
    if [ -n "$next" ]; then
      printf '\n## Next action\n\n%s\n' "$next"
    fi
  } > "$dir/handoff.md"
  meta_set "$meta" owner ego
  meta_set "$meta" updated_at "$(now)"
  append_event handoff "$id" "$summary"
  printf 'handed off %s to Ego\n' "$id"
}

cmd_takeback() {
  local ref= session= id meta current=
  while [ $# -gt 0 ]; do
    case "$1" in
      --session) [ $# -ge 2 ] || die "--session requires a value"; session=$2; shift 2 ;;
      --*) die "unknown takeback option '$1'" ;;
      *) [ -z "$ref" ] || die "takeback accepts one agent or window"; ref=$1; shift ;;
    esac
  done
  [ -n "$ref" ] || die "takeback requires an agent id or tmux window"
  if [ -n "$session" ]; then
    id=$(agent_id_in_session "$session" "$ref") \
      || die "unknown agent or window '$ref' in session '$session'"
  elif [ -f "$AGENTS_DIR/$ref/meta" ]; then
    id=$ref
  elif current=$(current_tmux_session); then
    id=$(agent_id_in_session "$current" "$ref") \
      || die "unknown agent or window '$ref' in current session '$current'"
  else
    die "unknown agent '$ref'; pass its full id or use --session"
  fi
  meta=$(agent_meta "$id")
  meta_set "$meta" owner human
  meta_set "$meta" updated_at "$(now)"
  append_event takeback "$id" "returned to Sandro"
  printf 'returned %s to human control\n' "$id"
  if [ -s "${meta%/meta}/status.log" ]; then
    printf 'latest report: '
    tail -n 1 "${meta%/meta}/status.log"
  else
    printf 'latest report: none recorded\n'
  fi
  printf 'reporting remains %s\n' "$(meta_get "$meta" reporting)"
}

cmd_takeback_workspace() {
  [ $# -eq 1 ] || die "takeback-workspace requires one session"
  local wanted=$1 dir meta session count=0
  cmd_scan >/dev/null
  for dir in "$AGENTS_DIR"/*; do
    [ -d "$dir" ] || continue
    meta="$dir/meta"
    [ -f "$meta" ] || continue
    session=$(meta_get "$meta" session)
    [ "$session" = "$wanted" ] || continue
    [ "$(meta_get "$meta" active)" != no ] || continue
    meta_set "$meta" owner human
    meta_set "$meta" updated_at "$(now)"
    count=$((count + 1))
  done
  append_event workspace-takeback "$wanted" "$count agents returned to Sandro"
  printf 'returned workspace %s and %s registered agents to human control\n' "$wanted" "$count"
}

cmd_spawn() {
  [ $# -ge 1 ] || die "spawn requires a name"
  local name=$1 session= root= id= brief= command_text= agent=codex agent_set=0 use_worktree=0 branch= window row pane launch prompt source_root repo_top worktree
  local created_session=0 primary_root=
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --session) [ $# -ge 2 ] || die "--session requires a value"; session=$2; shift 2 ;;
      --root) [ $# -ge 2 ] || die "--root requires a value"; root=$2; shift 2 ;;
      --id) [ $# -ge 2 ] || die "--id requires a value"; id=$2; shift 2 ;;
      --brief) [ $# -ge 2 ] || die "--brief requires text"; brief=$2; shift 2 ;;
      --agent) [ $# -ge 2 ] || die "--agent requires a value"; agent=$2; agent_set=1; shift 2 ;;
      --worktree) use_worktree=1; shift ;;
      --branch) [ $# -ge 2 ] || die "--branch requires a value"; branch=$2; use_worktree=1; shift 2 ;;
      --command) [ $# -ge 2 ] || die "--command requires text"; command_text=$2; shift 2 ;;
      *) die "unknown spawn option '$1'" ;;
    esac
  done
  if [ -n "$command_text" ] && [ "$agent_set" -eq 0 ]; then
    agent=unknown
  fi
  case "$agent" in codex|claude|unknown) ;; *) die "--agent must be codex or claude" ;; esac
  if [ -z "$command_text" ]; then
    [ "$agent" != unknown ] || die "unknown agents require --command"
    command -v "$agent" >/dev/null 2>&1 || die "$agent is not installed"
  fi
  require_tmux
  ensure_home
  if [ -z "$session" ] && [ -n "${TMUX:-}" ]; then
    session=$(tmux_cmd display-message -p '#S')
  fi
  [ -n "$session" ] || die "run spawn inside tmux or pass --session"
  if ! tmux_cmd has-session -t "=$session" 2>/dev/null; then
    valid_id "$session" \
      || die "new session names must be directory-safe; use a name such as 'music-generation'"
    if [ -z "$root" ]; then
      primary_root=$(workspace_option @workspace_primary)
      [ -n "$primary_root" ] \
        || die "tmux session '$session' does not exist and @workspace_primary is not configured; pass --root"
      root="$primary_root/$session"
    fi
    mkdir -p "$root"
    tmux_cmd new-session -d -s "$session" -c "$root"
    record_workspace "$session" "$root"
    append_event workspace-created "$session" "$root"
    created_session=1
  fi
  window=$name
  if inventory | awk -F '\t' -v s="$session" -v w="$window" '$1 == s && $2 == w { found=1 } END { exit !found }'; then
    die "tmux window $session:$window already exists"
  fi
  if [ -z "$root" ]; then
    root=$(resolve_session_root "$session" || true)
  fi
  [ -d "$root" ] \
    || die "cannot determine a directory for tmux session '$session'; pass --root or fix the recorded workspace root"
  id=${id:-$(clean_id "$session--$window")}
  valid_id "$id" || die "invalid agent id '$id'"
  source_root=$root
  worktree=
  if [ "$use_worktree" -eq 1 ]; then
    command -v git >/dev/null 2>&1 || die "git is not installed"
    repo_top=$(git -C "$source_root" rev-parse --show-toplevel 2>/dev/null) \
      || die "worktree root '$source_root' is not inside a Git repository"
    worktree="$WORKTREES_DIR/$id"
    [ ! -e "$worktree" ] || die "worktree path '$worktree' already exists"
    branch=${branch:-ego/$id}
    git check-ref-format --branch "$branch" >/dev/null 2>&1 \
      || die "invalid branch name '$branch'"
    if git -C "$repo_top" show-ref --verify --quiet "refs/heads/$branch"; then
      git -C "$repo_top" worktree add "$worktree" "$branch"
    else
      git -C "$repo_top" worktree add -b "$branch" "$worktree" HEAD
    fi
    root=$worktree
  fi
  tmux_cmd new-window -d -t "=$session:" -n "$window" -c "$root"
  row=$(resolve_target "$session:$window")
  if [ -n "$command_text" ]; then
    record_agent "$id" "$row" "$root" ego "$agent" unknown >/dev/null
  else
    record_agent "$id" "$row" "$root" ego "$agent" on >/dev/null
  fi
  meta_set "$AGENTS_DIR/$id/meta" origin ego
  if [ -n "$worktree" ]; then
    meta_set "$AGENTS_DIR/$id/meta" source_root "$source_root"
    meta_set "$AGENTS_DIR/$id/meta" worktree "$worktree"
    meta_set "$AGENTS_DIR/$id/meta" branch "$branch"
  fi
  printf '%s\n' "$brief" > "$AGENTS_DIR/$id/brief.md"
  launch="$AGENTS_DIR/$id/launch.sh"
  if [ -n "$command_text" ]; then
    {
      printf '#!/bin/zsh\n'
      printf 'export EGO_HOME=%s\n' "$(shell_quote "$EGO_HOME")"
      printf 'export EGO_AGENT_ID=%s\n' "$(shell_quote "$id")"
      printf 'cd %s\n' "$(shell_quote "$root")"
      printf 'exec /bin/zsh -lc %s\n' "$(shell_quote "$command_text")"
    } > "$launch"
  else
    prompt="You are worker $id, tracked through Sandro's Ego. Read $AGENTS_DIR/$id/brief.md. Work in $root. Report material phase changes regardless of who is supervising with: $EGO_CLI_PATH report $id <working|idle|blocked|needs-decision|done|failed|note> <message>. Use idle when no task is assigned. Use done when your assigned scope is complete, even if the broader project has a later external gate. Use blocked only when the assigned scope cannot proceed. Check pending instructions at natural checkpoints with: $EGO_CLI_PATH inbox $id. Acknowledge each handled message with: $EGO_CLI_PATH ack $id <message-id>. Do not claim completion until the requested result is complete."
    {
      printf '#!/bin/zsh\n'
      printf 'export EGO_HOME=%s\n' "$(shell_quote "$EGO_HOME")"
      printf 'export EGO_AGENT_ID=%s\n' "$(shell_quote "$id")"
      if [ "$agent" = codex ]; then
        printf 'exec codex --sandbox workspace-write --add-dir %s -C %s %s\n' \
          "$(shell_quote "$EGO_HOME")" "$(shell_quote "$root")" "$(shell_quote "$prompt")"
      else
        printf 'cd %s\n' "$(shell_quote "$root")"
        printf 'exec claude --add-dir %s %s\n' "$(shell_quote "$EGO_HOME")" "$(shell_quote "$prompt")"
      fi
    } > "$launch"
  fi
  chmod 700 "$launch"
  pane=$(meta_get "$AGENTS_DIR/$id/meta" pane_id)
  tmux_cmd send-keys -t "$pane" "$(shell_quote "$launch")" Enter
  append_event spawned "$id" "$session:$window root=$root${worktree:+ branch=$branch}"
  if [ "$created_session" -eq 1 ]; then
    printf 'created workspace session %s at %s\n' "$session" "$source_root"
  fi
  printf 'spawned %s at %s:%s\n' "$id" "$session" "$window"
}

cmd_peek() {
  [ $# -ge 1 ] || die "peek requires an agent id"
  local meta pane lines=${2:-80}
  meta=$(agent_meta "$1")
  pane=$(meta_get "$meta" pane_id)
  case "$lines" in ''|*[!0-9]*) die "lines must be a positive integer" ;; esac
  tmux_cmd capture-pane -p -t "$pane" -S "-$lines"
}

queue_message() {
  local id=$1 text=$2 meta pane dir inbox message_id tmp notice buffer ego_cli suffix=0
  meta=$(agent_meta "$id")
  pane=$(meta_get "$meta" pane_id)
  pane_snapshot "$pane" >/dev/null || die "agent '$id' has no live pane"
  dir=${meta%/meta}
  inbox="$dir/inbox"
  mkdir -p "$inbox/handled"
  message_id="$(date -u '+%Y%m%dT%H%M%SZ')-$$"
  while [ -e "$inbox/$message_id.msg" ]; do
    suffix=$((suffix + 1))
    message_id="$(date -u '+%Y%m%dT%H%M%SZ')-$$-$suffix"
  done
  tmp=$(mktemp "$inbox/.message.XXXXXX")
  printf '%s\n' "$text" > "$tmp"
  mv "$tmp" "$inbox/$message_id.msg"
  ego_cli="EGO_HOME=$(shell_quote "$EGO_HOME") $(shell_quote "$EGO_CLI_PATH")"
  notice="EGO_INBOX: message $message_id is waiting. Read it with: $ego_cli inbox $id"
  buffer="ego-$id-$$"
  if tmux_cmd set-buffer -b "$buffer" -- "$notice" \
    && tmux_cmd paste-buffer -d -b "$buffer" -t "$pane" \
    && tmux_cmd send-keys -t "$pane" Enter; then
    :
  else
    printf 'warning: message %s is durable, but the pane notice failed\n' "$message_id" >&2
  fi
  printf '%s\n' "$message_id"
}

cmd_send() {
  [ $# -ge 2 ] || die "send requires an agent id and message"
  local id=$1 text message_id
  shift
  text=$*
  message_id=$(queue_message "$id" "$text")
  append_event sent "$id" "message=$message_id $text"
  printf 'queued %s for %s\n' "$message_id" "$id"
}

cmd_press() {
  [ $# -eq 2 ] || die "press requires an agent id and one allowed key"
  local id=$1 requested=$2 meta pane key
  meta=$(agent_meta "$id")
  pane=$(meta_get "$meta" pane_id)
  pane_snapshot "$pane" >/dev/null || die "agent '$id' has no live pane"
  case "$requested" in
    enter) key=Enter ;;
    escape|esc) key=Escape ;;
    y|n|p) key=$requested ;;
    *) die "press key must be enter, escape, y, n, or p" ;;
  esac
  tmux_cmd send-keys -t "$pane" "$key"
  append_event pressed "$id" "$requested"
  printf 'pressed %s for %s\n' "$requested" "$id"
}

cmd_inbox() {
  [ $# -eq 1 ] || die "inbox requires one agent id"
  local meta dir file found=0 message_id
  meta=$(agent_meta "$1")
  dir=${meta%/meta}
  for file in "$dir/inbox"/*.msg; do
    [ -f "$file" ] || continue
    found=1
    message_id=$(basename "$file" .msg)
    printf 'MESSAGE %s\n' "$message_id"
    cat "$file"
  done
  [ "$found" -eq 1 ] || printf 'No pending messages.\n'
}

cmd_ack() {
  [ $# -eq 2 ] || die "ack requires an agent id and message id"
  local meta dir message_id=$2
  case "$message_id" in ''|.*|*/*|*[!A-Za-z0-9._-]*) die "invalid message id '$message_id'" ;; esac
  meta=$(agent_meta "$1")
  dir=${meta%/meta}
  [ -f "$dir/inbox/$message_id.msg" ] || die "pending message '$message_id' does not exist"
  mkdir -p "$dir/inbox/handled"
  mv "$dir/inbox/$message_id.msg" "$dir/inbox/handled/$message_id.msg"
  append_event acknowledged "$1" "$message_id"
  printf 'acknowledged %s for %s\n' "$message_id" "$1"
}

cmd_onboard() {
  [ $# -eq 1 ] || die "onboard requires one agent id"
  local id=$1 meta message message_id ego_cli
  meta=$(agent_meta "$id")
  ego_cli="EGO_HOME=$(shell_quote "$EGO_HOME") $(shell_quote "$EGO_CLI_PATH")"
  message="Join Ego's reporting protocol while keeping the current human workflow. Report only material phase changes with: $ego_cli report $id <working|idle|blocked|needs-decision|done|failed|note> <message>. Use idle when no task is assigned. Use done when your assigned scope is complete, even if the broader project has a later external gate. Use blocked only when the assigned scope cannot proceed. Check instructions at natural checkpoints with: $ego_cli inbox $id. Acknowledge each handled instruction with: $ego_cli ack $id <message-id>. Reporting stays active whether owner is human or ego."
  message_id=$(queue_message "$id" "$message")
  meta_set "$meta" reporting on
  meta_set "$meta" updated_at "$(now)"
  append_event onboarded "$id" "message=$message_id"
  printf 'onboarded %s with message %s\n' "$id" "$message_id"
}

cmd_onboard_workspace() {
  [ $# -eq 1 ] || die "onboard-workspace requires one session"
  local wanted=$1 workspace_dir workspace_meta found=0 dir meta session id pane reporting
  local onboarded=0 already=0 unavailable=0
  cmd_scan >/dev/null

  for workspace_dir in "$WORKSPACES_DIR"/*; do
    [ -d "$workspace_dir" ] || continue
    workspace_meta="$workspace_dir/meta"
    [ -f "$workspace_meta" ] || continue
    [ "$(meta_get "$workspace_meta" session)" = "$wanted" ] || continue
    found=1
    break
  done
  [ "$found" -eq 1 ] || die "unknown workspace '$wanted'"

  for dir in "$AGENTS_DIR"/*; do
    [ -d "$dir" ] || continue
    meta="$dir/meta"
    [ -f "$meta" ] || continue
    session=$(meta_get "$meta" session)
    [ "$session" = "$wanted" ] || continue
    [ "$(meta_get "$meta" active)" != no ] || continue
    reporting=$(meta_get "$meta" reporting)
    if [ "$reporting" = on ]; then
      already=$((already + 1))
      continue
    fi
    id=$(meta_get "$meta" id)
    pane=$(meta_get "$meta" pane_id)
    if ! pane_snapshot "$pane" >/dev/null; then
      printf 'warning: skipped %s because its pane is unavailable\n' "$id" >&2
      unavailable=$((unavailable + 1))
      continue
    fi
    cmd_onboard "$id" >/dev/null
    onboarded=$((onboarded + 1))
  done

  append_event workspace-onboarded "$wanted" "$onboarded onboarded, $already already reporting, $unavailable unavailable"
  printf 'onboarded %s agents in workspace %s; %s already reporting; %s unavailable\n' \
    "$onboarded" "$wanted" "$already" "$unavailable"
}

cmd_report() {
  [ $# -ge 3 ] || die "report requires an id, state, and message"
  local id=$1 state=$2 meta dir message
  shift 2
  message=$*
  case "$state" in
    investigating|validating) state=working ;;
    waiting) state=idle ;;
    complete|completed) state=done ;;
    error) state=failed ;;
    working|idle|blocked|needs-decision|done|failed|note) ;;
    *) die "invalid state '$state'; run 'ego report --help' for accepted states" ;;
  esac
  meta=$(agent_meta "$id")
  dir=${meta%/meta}
  printf '%s\t%s\t%s\n' "$(now)" "$state" "$(one_line "$message")" >> "$dir/status.log"
  append_event "$state" "$id" "$message"
  printf 'recorded %s for %s\n' "$state" "$id"
}

cmd_watch() {
  local timeout=300 all=0 start lines now_lines batch matched
  while [ $# -gt 0 ]; do
    case "$1" in
      --all) all=1; shift ;;
      ''|*[!0-9]*) die "watch timeout must be an integer" ;;
      *) timeout=$1; shift ;;
    esac
  done
  case "$timeout" in ''|*[!0-9]*) die "watch timeout must be an integer" ;; esac
  ensure_home
  lines=$(wc -l < "$EVENTS_FILE" | tr -d ' ')
  start=$SECONDS
  while [ $((SECONDS - start)) -lt "$timeout" ]; do
    now_lines=$(wc -l < "$EVENTS_FILE" | tr -d ' ')
    if [ "$now_lines" -gt "$lines" ]; then
      batch=$(tail -n "+$((lines + 1))" "$EVENTS_FILE")
      lines=$now_lines
      if [ "$all" -eq 1 ]; then
        printf '%s\n' "$batch"
        return 0
      fi
      matched=$(printf '%s\n' "$batch" | awk -F '\t' '$2 ~ /^(handoff|workspace-handoff|takeback|workspace-takeback|blocked|needs-decision|done|failed)$/')
      if [ -n "$matched" ]; then
        printf '%s\n' "$matched"
        return 0
      fi
    fi
    sleep 1
  done
  printf 'No actionable events within %s seconds.\n' "$timeout"
}

cmd_start() {
  local session= window=ego agent=codex row pane launch prompt controller_dir guide
  while [ $# -gt 0 ]; do
    case "$1" in
      --session) [ $# -ge 2 ] || die "--session requires a value"; session=$2; shift 2 ;;
      --window) [ $# -ge 2 ] || die "--window requires a value"; window=$2; shift 2 ;;
      --agent) [ $# -ge 2 ] || die "--agent requires a value"; agent=$2; shift 2 ;;
      *) die "unknown start option '$1'" ;;
    esac
  done
  case "$agent" in codex|claude) ;; *) die "--agent must be codex or claude" ;; esac
  command -v "$agent" >/dev/null 2>&1 || die "$agent is not installed"
  require_tmux
  ensure_home
  controller_dir="$EGO_HOME/controller"
  guide=$CONTROLLER_GUIDE
  [ -f "$guide" ] || guide="$REPO_ROOT/CONTROLLER.md"
  [ -f "$guide" ] || die "controller guide is missing; run 'ego install'"
  if [ -z "$session" ] && [ -n "${TMUX:-}" ]; then
    session=$(tmux_cmd display-message -p '#S')
  fi
  [ -n "$session" ] || die "run start inside tmux or pass --session"
  if inventory | awk -F '\t' -v s="$session" -v w="$window" '$1 == s && $2 == w { found=1 } END { exit !found }'; then
    die "tmux window $session:$window already exists"
  fi
  tmux_cmd new-window -d -t "=$session:" -n "$window" -c "$controller_dir"
  row=$(resolve_target "$session:$window")
  IFS=$'\t' read -r _ _ _ pane _ <<< "$row"
  launch="$EGO_HOME/controller-launch.sh"
  prompt="You are Sandro's Ego. Read and follow $guide. Start by running $EGO_CLI_PATH session-start. Use $EGO_CLI_PATH for Ego commands."
  {
    printf '#!/bin/zsh\n'
    printf 'export EGO_HOME=%s\n' "$(shell_quote "$EGO_HOME")"
    if [ "$agent" = codex ]; then
      printf 'exec codex --sandbox workspace-write --add-dir %s -C %s %s\n' \
        "$(shell_quote "$EGO_HOME")" "$(shell_quote "$controller_dir")" "$(shell_quote "$prompt")"
    else
      printf 'cd %s\n' "$(shell_quote "$controller_dir")"
      printf 'exec claude --add-dir %s %s\n' "$(shell_quote "$EGO_HOME")" "$(shell_quote "$prompt")"
    fi
  } > "$launch"
  chmod 700 "$launch"
  {
    printf 'session=%s\nwindow=%s\npane_id=%s\nstarted_at=%s\n' "$session" "$window" "$pane" "$(now)"
  } > "$EGO_HOME/controller.meta"
  tmux_cmd send-keys -t "$pane" "$(shell_quote "$launch")" Enter
  append_event controller ego "$session:$window"
  printf 'started Ego at %s:%s\n' "$session" "$window"
}

command_name=${1:-help}
[ $# -eq 0 ] || shift
if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  command_usage "$command_name"
  exit 0
fi
case "$command_name" in
  help)
    if [ $# -gt 0 ]; then command_usage "$1"; else usage; fi
    ;;
  -h|--help) usage ;;
  install) cmd_install "$@" ;;
  init) cmd_init "$@" ;;
  scan) cmd_scan "$@" ;;
  list) cmd_list "$@" ;;
  workspaces) cmd_workspaces "$@" ;;
  context|status) cmd_context "$@" ;;
  session-start) cmd_session_start "$@" ;;
  register) require_tmux; cmd_register "$@" ;;
  spawn) cmd_spawn "$@" ;;
  onboard) require_tmux; cmd_onboard "$@" ;;
  onboard-workspace) require_tmux; cmd_onboard_workspace "$@" ;;
  handoff) require_tmux; cmd_handoff "$@" ;;
  checkpoint) require_tmux; cmd_checkpoint "$@" ;;
  stow) require_tmux; cmd_stow "$@" ;;
  archive-workspace) cmd_archive_workspace "$@" ;;
  handoff-workspace) require_tmux; cmd_handoff_workspace "$@" ;;
  takeback-workspace) require_tmux; cmd_takeback_workspace "$@" ;;
  recover) cmd_recover "$@" ;;
  takeback) cmd_takeback "$@" ;;
  peek) require_tmux; cmd_peek "$@" ;;
  send) require_tmux; cmd_send "$@" ;;
  press) require_tmux; cmd_press "$@" ;;
  inbox) cmd_inbox "$@" ;;
  ack) cmd_ack "$@" ;;
  report) cmd_report "$@" ;;
  watch) cmd_watch "$@" ;;
  start) cmd_start "$@" ;;
  *) usage >&2; die "unknown command '$command_name'" ;;
esac
