#!/usr/bin/env bash
set -eu

SCRIPT_PATH=${BASH_SOURCE[0]}
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR=$(cd "$(dirname "$SCRIPT_PATH")" && pwd)
  LINK_TARGET=$(readlink "$SCRIPT_PATH")
  case "$LINK_TARGET" in
    /*) SCRIPT_PATH=$LINK_TARGET ;;
    *) SCRIPT_PATH="$SCRIPT_DIR/$LINK_TARGET" ;;
  esac
done
SCRIPT_DIR=$(cd "$(dirname "$SCRIPT_PATH")" && pwd)
if [ -f "$SCRIPT_DIR/repo-root" ]; then
  IFS= read -r REPO_ROOT < "$SCRIPT_DIR/repo-root"
else
  REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
fi
# Temporary Codex permission workaround: controller prompts use this protected
# installed copy so a narrow command rule can reach tmux without full access.
EGO_CLI_PATH="$SCRIPT_DIR/ego"
EGO_ROOT=${EGO_ROOT:-$HOME/.ego}
EGO_HOME=${EGO_HOME:-$EGO_ROOT/state}
CONTROLLER_GUIDE=${EGO_CONTROLLER_GUIDE:-$EGO_ROOT/CONTROLLER.md}
AGENTS_DIR="$EGO_HOME/agents"
WORKSPACES_DIR="$EGO_HOME/workspaces"
WORKTREES_DIR="$EGO_HOME/worktrees"
CONTROLLERS_DIR="$EGO_HOME/controllers"
EVENTS_FILE="$EGO_HOME/events.log"
# Set by the dispatcher when --any-session is present anywhere in the argument
# list. It is the deliberate override for a scope refusal.
EGO_ANY_SESSION=0

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Sandro's Ego manages agent windows in an existing tmux server.

Usage:
A target is an agent id, a window name in the current session, session:window,
or session: for every agent in a workspace.

Workers:
  ego report <id> <working|idle|blocked|needs-decision|done|failed|note> <message...>
  ego inbox <id>
  ego ack <id> <message-id>

Controllers:
  ego context [--session <session>] [--all] [--full]
  ego watch [seconds] [--all]
  ego list [active] [--session <session>] [--stale|--controllers|--workspaces]
  ego peek <id> [lines]
  ego send <id> <message...>
  ego press <id> <enter|escape|y|n|p>
  ego spawn <name> [--session <session>] [--root <path>] [--id <id>]
                         [--brief <text>] [--agent <codex|claude|kiro>]
                         [--worktree] [--branch <name>]
                         [--command <shell-command>]
  ego onboard <target>          ego offboard <id|session:window>
  ego handoff <target> --summary <text> [--next <text>]
  ego handback <target>
  ego checkpoint <session> --summary <text> [--next <text>]
  ego stow <session> --summary <text> [--next <text>]
  ego retire <target> | --stale [--session <session>] | --controller <id>

Sandro:
  ego install
  ego start [--session <session>] [--window <name>] [--agent <codex|claude|kiro>]
                         [--scope <session,...>]
  ego scope [<controller-id>] [<session,...>|+<session>|-<session>]
  ego scan
  ego register <window|session:window> [--id <id>] [--root <path>]
                         [--agent <type>]
  ego purge <id>

Older names: takeback (handback), handoff-workspace, takeback-workspace, and
onboard-workspace (the session: target), session-start and recover (context,
context --full), forget, prune, and archive-workspace (retire, purge),
controllers and workspaces (list), promote (scope), init.

Environment:
  EGO_ROOT          Installation root. Default: ~/.ego
  EGO_HOME          State directory. Default: ~/.ego/state
  EGO_AGENT_NAVIGATOR  Agent Navigator executable. Default: installed helper.
  EGO_TMUX_SOCKET   Optional tmux socket name, useful for isolated servers.
  EGO_CONTROLLER_ID Identifies the calling controller. Exported by its launch
                    script; resolved from the tmux pane otherwise.

Scope:
  A controller may only act on the sessions its scope lists. Add
  --any-session to any command to cross that boundary deliberately.
EOF
}

command_usage() {
  case "$1" in
    handoff|handoff-workspace)
      cat <<'EOF'
Usage: ego handoff <target> [--session <session>] --summary <text> [--next <text>]

Give Ego continuing supervision responsibility for one worker, or for every
active worker in a workspace with a session: target. The command does not
restart or steer the worker. --summary is required; --next is optional. The
note also records each worker's live state: latest report, agent process,
screen observation, pending inbox, and the last 20 pane lines.
EOF
      ;;
    handback|takeback|takeback-workspace)
      cat <<'EOF'
Usage: ego handback <target> [--session <session>]

Return supervision responsibility to Sandro for one worker, or for every active
worker in a workspace with a session: target. Reporting stays enabled. The
command prints the worker's latest durable report when one exists. takeback is
the older name.
EOF
      ;;
    onboard|onboard-workspace|offboard)
      cat <<'EOF'
Usage: ego onboard <target>
       ego offboard <id|session:window>

onboard sends the reporting and inbox contract to an agent and sets
reporting=on, registering the window first when Ego has no record of it. A
session: target onboards every active agent in that workspace that does not
report yet. offboard withdraws the contract and sets reporting=off. Neither
changes ownership.
EOF
      ;;
    spawn)
      cat <<'EOF'
Usage: ego spawn <name> [--session <session>] [--root <path>] [--id <id>]
                 [--brief <text>] [--agent <codex|claude|kiro>]
                 [--worktree] [--branch <name>] [--command <shell-command>]

Create a tracked worker window. Kiro is the default agent. --brief is
optional. Inside tmux, --session is optional and defaults to the current
session. A missing named session is created below @workspace_primary unless
--root is supplied. Names are short <topic>-<role> kebab-case, such as
az-analyzer or stt-research: at most 3 parts and 24 characters.
EOF
      ;;
    report)
      cat <<'EOF'
Usage: ego report <id> <working|idle|blocked|needs-decision|done|failed|note> <message...>

Append a material worker status update to durable state. Common phase words are
normalized: investigating and validating become working, waiting becomes idle,
complete becomes done, and error becomes failed.
EOF
      ;;
    watch)
      cat <<'EOF'
Usage: ego watch [seconds] [--all]

Wait for an actionable event. The default timeout is 300 seconds. A timeout
prints a quiet-period message and exits successfully. --all also wakes for
routine events.

A controller wakes only for events in the sessions its scope lists, plus
fleet-wide events that name no session. --all widens the event kinds, not the
scope.

Each caller keeps its own cursor, so an event that arrives between two watch
calls is surfaced by the next one instead of being missed. The first watch of a
session starts from the present and does not replay an old log.
EOF
      ;;
    press)
      cat <<'EOF'
Usage: ego press <id> <enter|escape|y|n|p>

Send one allowed key to a worker's live terminal UI. Inspect the pane first.
Use this for an explicit interactive prompt, never for a worker instruction.
EOF
      ;;
    retire|forget|prune|archive-workspace)
      cat <<'EOF'
Usage: ego retire <id|session:window>
       ego retire <session>:
       ego retire --stale [--session <session>]
       ego retire --controller <id>

Mark records inactive so they leave context. A target names one agent, a
trailing colon names every agent in a workspace, --stale takes every cleanup
candidate in scope ('ego list --stale'), and --controller takes a controller
record. Records stay on disk; 'register' or 'spawn' brings an agent back.
Nothing here closes a tmux window or touches a worktree. forget, prune, and
archive-workspace are older names.
EOF
      ;;
    purge)
      cat <<'EOF'
Usage: ego purge <id>

Remove one agent's record directory, including its brief, handoff, status log,
and inbox. Refuses while the pane is still live. The only delete in Ego.
EOF
      ;;
    list|controllers|workspaces)
      cat <<'EOF'
Usage: ego list [active] [--session <session>]
       ego list --stale [--session <session>]
       ego list --controllers
       ego list --workspaces [active]

List agent records. 'active' hides retired ones. --stale lists cleanup
candidates with a reason and the tmux command that would close each window.
--controllers and --workspaces list those records instead.
EOF
      ;;
    context|session-start)
      cat <<'EOF'
Usage: ego context [--session <session>] [--all] [--full]

Scan tmux, then print startup context for the sessions the calling
controller's scope lists, its own session by default. --session narrows to one
session, --all forces the whole server, and --full adds the recovery view:
workspace records whose session is gone, their latest checkpoint, and each
agent's endpoint. session-start and recover are older names.
EOF
      ;;
    scope|promote)
      cat <<'EOF'
Usage: ego scope
       ego scope <session,...>|+<session>|-<session>
       ego scope <controller-id> <session,...>|+<session>|-<session>

Show or change which sessions a controller covers, without restarting it. A
controller covers its own session by default. A list replaces the scope, +A
adds a session, and -A removes one. With one argument the calling controller
is changed; name the controller first to change another. A controller that
spawns into a new session gets it added. promote is the older name: it lists
every session live right now, and 'promote --scope session' narrows back.
EOF
      ;;
    *)
      usage
      ;;
  esac
}

cmd_install() {
  local install_dir=${EGO_INSTALL_DIR:-$EGO_ROOT/bin}
  local controller_guide=${EGO_CONTROLLER_GUIDE:-$EGO_ROOT/CONTROLLER.md}
  local root_tmp
  mkdir -p "$install_dir" "$(dirname "$controller_guide")"
  install -m 755 "$REPO_ROOT/bin/ego" "$install_dir/ego"
  install -m 644 "$REPO_ROOT/CONTROLLER.md" "$controller_guide"
  root_tmp=$(mktemp "$install_dir/.repo-root.XXXXXX")
  printf '%s\n' "$REPO_ROOT" > "$root_tmp"
  mv "$root_tmp" "$install_dir/repo-root"
  printf 'installed Ego at %s\n' "$install_dir/ego"
}

tmux_cmd() {
  if [ -n "${EGO_TMUX_SOCKET:-}" ]; then
    command tmux -L "$EGO_TMUX_SOCKET" "$@"
  else
    command tmux "$@"
  fi
}

require_tmux() {
  command -v tmux >/dev/null 2>&1 || die "tmux is not installed"
  tmux_cmd list-sessions >/dev/null 2>&1 || die "no tmux server is running"
}

ensure_home() {
  mkdir -p "$AGENTS_DIR" "$WORKSPACES_DIR" "$WORKTREES_DIR" "$CONTROLLERS_DIR" "$EGO_HOME/controller"
  [ -e "$EVENTS_FILE" ] || : > "$EVENTS_FILE"
  migrate_controller_meta
}

valid_id() {
  case "$1" in
    ''|.*|*/*|*[!A-Za-z0-9._-]*) return 1 ;;
    *) return 0 ;;
  esac
}

clean_id() {
  printf '%s' "$1" | LC_ALL=C tr -c 'A-Za-z0-9._-' '-'
}

one_line() {
  printf '%s' "$1" | tr '\t\r\n' '   '
}

now() {
  date -u '+%Y-%m-%dT%H:%M:%SZ'
}

shell_quote() {
  printf "'"
  printf '%s' "$1" | sed "s/'/'\\\\''/g"
  printf "'"
}

meta_get() {
  local file=$1 key=$2
  # An empty or missing path would make awk read stdin and block forever, which
  # is reachable because 'die' inside a command substitution cannot stop the
  # caller: bash does not honor set -e in that subshell.
  [ -n "$file" ] && [ -f "$file" ] || return 0
  awk -F= -v key="$key" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "$file"
}

meta_set() {
  local file=$1 key=$2 value=$3 tmp
  tmp=$(mktemp "${file}.tmp.XXXXXX")
  awk -F= -v key="$key" -v value="$value" '
    BEGIN { found = 0 }
    $1 == key { print key "=" value; found = 1; next }
    { print }
    END { if (!found) print key "=" value }
  ' "$file" > "$tmp"
  mv "$tmp" "$file"
}

append_event() {
  local kind=$1 id=$2 detail=$3 session=${4:-}
  ensure_home
  printf '%s\t%s\t%s\t%s\t%s\n' "$(now)" "$kind" "$id" "$(one_line "$detail")" "$(one_line "$session")" >> "$EVENTS_FILE"
}

epoch_to_iso() {
  date -u -d "@$1" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || date -u -r "$1" '+%Y-%m-%dT%H:%M:%SZ'
}

# A pane id is unique only within one tmux server's lifetime. A restarted server
# numbers its panes from %0 again, so a record's pane id may name a different
# pane now. The server's start time tells the two apart.
SERVER_STARTED=
SERVER_STARTED_ISO=
SERVER_LOADED=0
load_server_identity() {
  [ "$SERVER_LOADED" -eq 0 ] || return 0
  SERVER_LOADED=1
  SERVER_STARTED=$(tmux_cmd display-message -p '#{start_time}' 2>/dev/null || true)
  case "$SERVER_STARTED" in ''|*[!0-9]*) SERVER_STARTED=; return 0 ;; esac
  SERVER_STARTED_ISO=$(epoch_to_iso "$SERVER_STARTED")
}

# Succeed when the pane a record names belongs to the running tmux server. A
# record carries the server's start time from when it was written. An older
# record without one is trusted only when it was created after this server
# started and, given a live pane pid, when that pid matches the stored one.
record_on_this_server() {
  local meta=$1 live_pid=${2:-} recorded since pid
  load_server_identity
  [ -n "$SERVER_STARTED" ] || return 1
  recorded=$(meta_get "$meta" server_started)
  if [ -n "$recorded" ]; then
    [ "$recorded" = "$SERVER_STARTED" ]
    return
  fi
  since=$(meta_get "$meta" started_at)
  [ -n "$since" ] || since=$(meta_get "$meta" created_at)
  [ -n "$since" ] || return 1
  [[ ! "$since" < "$SERVER_STARTED_ISO" ]] || return 1
  pid=$(meta_get "$meta" pane_pid)
  [ -z "$live_pid" ] || [ -z "$pid" ] || [ "$pid" = "$live_pid" ]
}

inventory() {
  local fmt
  fmt=$'#{session_name}\t#{window_name}\t#{window_id}\t#{pane_id}\t#{pane_current_path}\t#{pane_current_command}\t#{session_path}\t#{pane_index}\t#{pane_pid}\t#{pane_tty}'
  tmux_cmd list-panes -a -F "$fmt"
}

resolve_target() {
  local selector=$1 matches session window current=
  if [ -n "${TMUX:-}" ]; then
    current=$(current_tmux_session 2>/dev/null || true)
  fi

  if [[ "$selector" == *:* ]]; then
    session=${selector%%:*}
    window=${selector#*:}
    matches=$(inventory | awk -F '\t' -v s="$session" -v w="$window" '$1 == s && $2 == w')
  elif [ -n "$current" ] && inventory | awk -F '\t' -v s="$current" -v w="$selector" '$1 == s && $2 == w { found=1 } END { exit !found }'; then
    matches=$(inventory | awk -F '\t' -v s="$current" -v w="$selector" '$1 == s && $2 == w')
  else
    matches=$(inventory | awk -F '\t' -v w="$selector" '$2 == w')
  fi

  [ -n "$matches" ] || die "no tmux window matches '$selector'"
  [ "$(printf '%s\n' "$matches" | wc -l | tr -d ' ')" -eq 1 ] \
    || die "more than one tmux window matches '$selector'; use session:window"
  printf '%s\n' "$matches"
}

record_agent() {
  local id=$1 row=$2 root_override=${3:-} owner_override=${4:-} agent_override=${5:-} reporting_override=${6:-}
  local session window window_id pane_id cwd command session_path pane_index pane_pid pane_tty root workspace_root dir meta created owner agent reporting origin active last_seen tmp
  local existing_root= existing_workspace_root= source_root= worktree= branch=
  IFS=$'\t' read -r session window window_id pane_id cwd command session_path pane_index pane_pid pane_tty <<< "$row"
  valid_id "$id" || die "invalid agent id '$id'"
  dir="$AGENTS_DIR/$id"
  meta="$dir/meta"
  mkdir -p "$dir/inbox"
  created=$(now)
  owner=human
  agent=unknown
  reporting=unknown
  origin=human
  active=yes
  last_seen=
  if [ -f "$meta" ]; then
    created=$(meta_get "$meta" created_at)
    owner=$(meta_get "$meta" owner)
    agent=$(meta_get "$meta" agent)
    [ -n "$agent" ] || agent=unknown
    reporting=$(meta_get "$meta" reporting)
    [ -n "$reporting" ] || reporting=unknown
    existing_root=$(meta_get "$meta" root)
    existing_workspace_root=$(meta_get "$meta" workspace_root)
    source_root=$(meta_get "$meta" source_root)
    worktree=$(meta_get "$meta" worktree)
    branch=$(meta_get "$meta" branch)
    origin=$(meta_get "$meta" origin)
    # Retirement is deliberate, so a refresh preserves it. Only 'register' and
    # 'spawn' put a record back into active context.
    active=$(meta_get "$meta" active)
    [ -n "$active" ] || active=yes
    last_seen=$(meta_get "$meta" last_seen)
    if [ -z "$origin" ]; then
      if [ -f "$dir/launch.sh" ]; then origin=ego; else origin=human; fi
    fi
  fi
  [ -z "$owner_override" ] || owner=$owner_override
  [ -z "$agent_override" ] || agent=$agent_override
  [ -z "$reporting_override" ] || reporting=$reporting_override
  root=${root_override:-$existing_root}
  [ -n "$root" ] || root=$session_path
  [ -n "$root" ] || root=$cwd
  workspace_root=${existing_workspace_root:-$session_path}
  [ -n "$workspace_root" ] || workspace_root=$root
  tmp=$(mktemp "$dir/.meta.XXXXXX")
  {
    printf 'id=%s\n' "$id"
    printf 'session=%s\n' "$session"
    printf 'window=%s\n' "$window"
    printf 'window_id=%s\n' "$window_id"
    printf 'pane_id=%s\n' "$pane_id"
    printf 'pane_index=%s\n' "$pane_index"
    printf 'pane_pid=%s\n' "$pane_pid"
    printf 'pane_tty=%s\n' "$pane_tty"
    load_server_identity
    [ -z "$SERVER_STARTED" ] || printf 'server_started=%s\n' "$SERVER_STARTED"
    printf 'root=%s\n' "$root"
    printf 'workspace_root=%s\n' "$workspace_root"
    [ -z "$source_root" ] || printf 'source_root=%s\n' "$source_root"
    [ -z "$worktree" ] || printf 'worktree=%s\n' "$worktree"
    [ -z "$branch" ] || printf 'branch=%s\n' "$branch"
    printf 'cwd=%s\n' "$cwd"
    printf 'command=%s\n' "$command"
    printf 'agent=%s\n' "$agent"
    printf 'owner=%s\n' "$owner"
    printf 'reporting=%s\n' "$reporting"
    printf 'origin=%s\n' "$origin"
    printf 'active=%s\n' "$active"
    [ -z "$last_seen" ] || printf 'last_seen=%s\n' "$last_seen"
    printf 'created_at=%s\n' "$created"
    printf 'updated_at=%s\n' "$(now)"
  } > "$tmp"
  mv "$tmp" "$meta"
  printf '%s\n' "$id"
}

register_target() {
  local selector=$1 requested_id=${2:-} root=${3:-} agent=${4:-} row session window id
  row=$(resolve_target "$selector")
  IFS=$'\t' read -r session window _ <<< "$row"
  id=${requested_id:-$(clean_id "$session--$window")}
  record_agent "$id" "$row" "$root" "" "$agent"
  # Registering is an explicit request to track, so it reverses a retirement.
  meta_set "$AGENTS_DIR/$id/meta" active yes
}

agent_meta() {
  local id=$1 meta
  meta="$AGENTS_DIR/$id/meta"
  [ -f "$meta" ] || die "unknown agent '$id'; run 'ego scan' or 'ego register' first"
  printf '%s\n' "$meta"
}

# Mark one agent record inactive. Returns 1 when it already was, so callers can
# count only the records this pass actually changed. Records are never deleted
# here: 'ego recover' must still be able to read a retired worker's history.
retire_agent_record() {
  local meta=$1
  [ "$(meta_get "$meta" active)" != no ] || return 1
  meta_set "$meta" active no
  meta_set "$meta" last_seen "$(meta_get "$meta" updated_at)"
  meta_set "$meta" updated_at "$(now)"
  return 0
}

agent_session() {
  local meta="$AGENTS_DIR/$1/meta"
  [ -f "$meta" ] || return 0
  meta_get "$meta" session
}

# --- Controllers -------------------------------------------------------------
# A controller is a record like an agent, so starting one has no effect on any
# controller already running. The single controller.meta file it replaces held
# per-controller facts globally, so every start overwrote the last one.

controller_meta() {
  local meta="$CONTROLLERS_DIR/$1/meta"
  [ -f "$meta" ] || return 1
  printf '%s\n' "$meta"
}

# Write or overwrite one controller record. Ids are reused, because window names
# default to 'ego', and a controller record holds only location and scope, so
# there is no history worth preserving behind a suffix.
record_controller() {
  local id=$1 session=$2 window=$3 pane=$4 root=$5 scope=$6 started=${7:-} dir tmp socket
  valid_id "$id" || die "invalid controller id '$id'"
  socket=$(tmux_cmd display-message -p '#{socket_path}' 2>/dev/null || true)
  dir="$CONTROLLERS_DIR/$id"
  mkdir -p "$dir"
  tmp=$(mktemp "$dir/.meta.XXXXXX")
  {
    printf 'id=%s\n' "$id"
    printf 'session=%s\n' "$session"
    printf 'window=%s\n' "$window"
    printf 'pane_id=%s\n' "$pane"
    printf 'socket=%s\n' "$socket"
    # A migrated record keeps its original start time and no server stamp, so
    # its pane is judged against the running server like any older record.
    if [ -z "$started" ]; then
      load_server_identity
      [ -z "$SERVER_STARTED" ] || printf 'server_started=%s\n' "$SERVER_STARTED"
    fi
    printf 'root=%s\n' "$root"
    printf 'scope=%s\n' "$scope"
    printf 'active=yes\n'
    printf 'started_at=%s\n' "${started:-$(now)}"
    printf 'updated_at=%s\n' "$(now)"
  } > "$tmp"
  mv "$tmp" "$dir/meta"
}

active_controller_panes() {
  local dir meta
  for dir in "$CONTROLLERS_DIR"/*; do
    [ -d "$dir" ] || continue
    meta="$dir/meta"
    [ -f "$meta" ] || continue
    [ "$(meta_get "$meta" active)" != no ] || continue
    meta_get "$meta" pane_id
  done
}

retire_controller_record() {
  local meta=$1 id
  [ "$(meta_get "$meta" active)" != no ] || return 1
  id=$(meta_get "$meta" id)
  meta_set "$meta" active no
  meta_set "$meta" updated_at "$(now)"
  # A retired controller will never read its own event cursor again.
  rm -f -- "$EGO_HOME/watch/$(clean_id "$id").cursor"
  return 0
}

# A pane is a controller or a worker, never both. Enforced by construction, so a
# controller that an earlier scan adopted as a worker leaves the agent list.
enforce_controller_panes() {
  local panes dir meta pane retired=0
  panes=$(active_controller_panes)
  [ -n "$panes" ] || { printf '0\n'; return 0; }
  for dir in "$AGENTS_DIR"/*; do
    [ -d "$dir" ] || continue
    meta="$dir/meta"
    [ -f "$meta" ] || continue
    pane=$(meta_get "$meta" pane_id)
    [ -n "$pane" ] || continue
    printf '%s\n' "$panes" | grep -Fxq -- "$pane" || continue
    if retire_agent_record "$meta"; then
      retired=$((retired + 1))
    fi
  done
  printf '%s\n' "$retired"
}

# Convert the single global controller.meta into a record once. The old file is
# left in place and never read again. 'root' is synthesized and may be
# unresolvable, which is not worth dying over.
migrate_controller_meta() {
  local old="$EGO_HOME/controller.meta" marker="$CONTROLLERS_DIR/.migrated"
  [ -f "$old" ] || return 0
  [ ! -f "$marker" ] || return 0
  local session window pane scope root= id started
  session=$(meta_get "$old" session)
  window=$(meta_get "$old" window)
  pane=$(meta_get "$old" pane_id)
  scope=$(meta_get "$old" scope)
  started=$(meta_get "$old" started_at)
  [ -n "$started" ] || started=unknown
  case "$scope" in session|server) ;; *) scope=server ;; esac
  : > "$marker"
  [ -n "$session" ] && [ -n "$window" ] || return 0
  root=$(resolve_session_root "$session" 2>/dev/null || true)
  id=$(clean_id "$session--$window")
  record_controller "$id" "$session" "$window" "$pane" "$root" "$scope" "$started"
  enforce_controller_panes >/dev/null
}

# The controller that is calling, resolved from its exported id first and its
# tmux pane second. Returns 1 for a worker or a human in a plain shell.
caller_controller_id() {
  local dir meta pane socket caller_socket
  if [ -n "${EGO_CONTROLLER_ID:-}" ] && [ -f "$CONTROLLERS_DIR/$EGO_CONTROLLER_ID/meta" ]; then
    printf '%s\n' "$EGO_CONTROLLER_ID"
    return 0
  fi
  # A pane id is unique per tmux server, not per machine, so a pane id from
  # another server can collide with a recorded one. $TMUX names the caller's
  # server, and without it a pane id means nothing.
  [ -n "${TMUX_PANE:-}" ] && [ -n "${TMUX:-}" ] || return 1
  caller_socket=${TMUX%%,*}
  for dir in "$CONTROLLERS_DIR"/*; do
    [ -d "$dir" ] || continue
    meta="$dir/meta"
    [ -f "$meta" ] || continue
    pane=$(meta_get "$meta" pane_id)
    [ "$pane" = "$TMUX_PANE" ] || continue
    [ "$(meta_get "$meta" active)" != no ] || continue
    socket=$(meta_get "$meta" socket)
    [ -z "$socket" ] || [ "$socket" = "$caller_socket" ] || continue
    # The socket path survives a server restart, so a matching pane id can
    # still belong to a pane the controller never ran in.
    record_on_this_server "$meta" || continue
    meta_get "$meta" id
    return 0
  done
  return 1
}

# A controller's scope, one session per line. The field holds a comma list of
# sessions. Two older values remain readable: 'session' means the controller's
# own session, and 'server' (or an empty field) means every session, printed as
# nothing, until the scope is rewritten with 'ego scope'.
controller_scope_list() {
  local meta=$1 scope
  scope=$(meta_get "$meta" scope)
  case "$scope" in
    ''|server) return 0 ;;
    session) meta_get "$meta" session ;;
    *) printf '%s\n' "$scope" | tr ',' '\n' | grep . || true ;;
  esac
}

# Sessions the caller may act on, one per line. Empty output means every
# session, which passes every check: a human in a plain shell, or a controller
# still holding the older 'server' value.
scope_sessions() {
  local id
  if id=$(caller_controller_id); then
    controller_scope_list "$CONTROLLERS_DIR/$id/meta"
    return 0
  fi
  # A worker invokes ego too. Without this it would fall through to server scope
  # and reach a sibling in another workspace.
  if [ -n "${EGO_AGENT_ID:-}" ] && [ -f "$AGENTS_DIR/$EGO_AGENT_ID/meta" ]; then
    meta_get "$AGENTS_DIR/$EGO_AGENT_ID/meta" session
  fi
}

# Succeed when a session is in a newline-separated list. An empty list is every
# session.
in_session_list() {
  [ -z "$2" ] || printf '%s\n' "$2" | grep -Fxq -- "$1"
}

# A newline list as "A, B" for messages.
session_list_text() {
  printf '%s\n' "$1" | grep . | paste -sd, - | sed 's/,/, /g'
}

# This is a coordination guard, not a security boundary: a caller that unsets
# EGO_AGENT_ID or edits its own record escapes it. It prevents accidents.
require_in_scope() {
  local session=$1 sessions
  [ "$EGO_ANY_SESSION" -eq 0 ] || return 0
  sessions=$(scope_sessions)
  [ -n "$sessions" ] || return 0
  if printf '%s\n' "$sessions" | grep -Fxq -- "$session"; then
    return 0
  fi
  die "session '$session' is outside this scope ($(session_list_text "$sessions")); Sandro must name the other workspace before you add --any-session"
}

agent_id_in_session() {
  local wanted_session=$1 wanted_agent=$2 dir meta found= id session window
  for dir in "$AGENTS_DIR"/*; do
    [ -d "$dir" ] || continue
    meta="$dir/meta"
    [ -f "$meta" ] || continue
    session=$(meta_get "$meta" session)
    [ "$session" = "$wanted_session" ] || continue
    id=$(meta_get "$meta" id)
    window=$(meta_get "$meta" window)
    if [ "$id" = "$wanted_agent" ] || [ "$window" = "$wanted_agent" ]; then
      [ -z "$found" ] || die "more than one agent matches '$wanted_agent' in session '$wanted_session'"
      found=$id
    fi
  done
  [ -n "$found" ] || return 1
  printf '%s\n' "$found"
}

current_tmux_session() {
  [ -n "${TMUX:-}" ] || return 1
  if [ -n "${TMUX_PANE:-}" ]; then
    tmux_cmd display-message -p -t "$TMUX_PANE" '#S' 2>/dev/null
  else
    tmux_cmd display-message -p '#S' 2>/dev/null
  fi
}

valid_agent() {
  case "$1" in codex|claude|kiro|gemini|aider|opencode|unknown) return 0 ;; *) return 1 ;; esac
}

# Agents Ego can launch itself. Others are registered or started with --command.
launchable_agent() {
  case "$1" in codex|claude|kiro) return 0 ;; *) return 1 ;; esac
}

agent_executable() {
  case "$1" in
    kiro) printf 'kiro-cli\n' ;;
    *) printf '%s\n' "$1" ;;
  esac
}

# Print the exec line that starts an agent in $root with $prompt. Codex is
# sandboxed to the workspace plus EGO_HOME; Claude and Kiro rely on their own
# permission model, so only Codex needs the state directory added explicitly.
launch_exec_line() {
  local agent=$1 root=$2 prompt=$3
  case "$agent" in
    codex)
      printf 'exec codex --sandbox workspace-write --add-dir %s -C %s %s\n' \
        "$(shell_quote "$EGO_HOME")" "$(shell_quote "$root")" "$(shell_quote "$prompt")"
      ;;
    claude)
      # The prompt must precede --add-dir: that option is variadic and would
      # otherwise consume the prompt as another directory.
      printf 'cd %s\n' "$(shell_quote "$root")"
      printf 'exec claude %s --add-dir %s\n' "$(shell_quote "$prompt")" "$(shell_quote "$EGO_HOME")"
      ;;
    kiro)
      printf 'cd %s\n' "$(shell_quote "$root")"
      printf 'exec kiro-cli chat %s\n' "$(shell_quote "$prompt")"
      ;;
    *) die "cannot launch agent type '$agent'" ;;
  esac
}

expand_workspace_root() {
  local value=$1
  case "$value" in
    '~') printf '%s\n' "$HOME" ;;
    '~/'*) printf '%s/%s\n' "$HOME" "${value#~/}" ;;
    '$HOME') printf '%s\n' "$HOME" ;;
    '$HOME/'*) printf '%s/%s\n' "$HOME" "${value#\$HOME/}" ;;
    *) printf '%s\n' "$value" ;;
  esac
}

workspace_option() {
  local name=$1 value
  value=$(tmux_cmd show-options -gqv "$name" 2>/dev/null || true)
  [ -z "$value" ] || expand_workspace_root "$value"
}

path_within() {
  case "$1" in "$2"|"$2"/*) return 0 ;; *) return 1 ;; esac
}

# A session path equal to a workspace root names the root, not a workspace.
# Sessions created outside Ego inherit the root as their path, so descend into
# the session-named directory that 'ego spawn' would have created there.
refine_workspace_root() {
  local session=$1 root=$2 base
  [ -n "$root" ] || return 1
  for base in "$(workspace_option @workspace_primary)" "$(workspace_option @workspace_secondary)"; do
    [ -n "$base" ] || continue
    if [ "${root%/}" = "${base%/}" ] && [ -d "$root/$session" ]; then
      printf '%s\n' "$root/$session"
      return 0
    fi
  done
  printf '%s\n' "$root"
}

workspace_kind() {
  local root=$1 primary secondary
  primary=$(workspace_option @workspace_primary)
  secondary=$(workspace_option @workspace_secondary)
  if [ -n "$primary" ] && path_within "$root" "$primary"; then
    printf 'primary\n'
  elif [ -n "$secondary" ] && path_within "$root" "$secondary"; then
    printf 'secondary\n'
  else
    printf 'external\n'
  fi
}

record_workspace() {
  local session=$1 root=$2 live=${3:-yes} id dir tmp
  id=$(clean_id "$session")
  dir="$WORKSPACES_DIR/$id"
  mkdir -p "$dir"
  # A workspace is in context while its tmux session lives, so the record holds
  # only where it is and whether it is live. An older record's archived state is
  # dropped here.
  tmp=$(mktemp "$dir/.meta.XXXXXX")
  {
    printf 'session=%s\n' "$session"
    printf 'root=%s\n' "$root"
    printf 'kind=%s\n' "$(workspace_kind "$root")"
    printf 'live=%s\n' "$live"
    printf 'updated_at=%s\n' "$(now)"
  } > "$tmp"
  mv "$tmp" "$dir/meta"
}

# Workspaces are recorded from live tmux sessions, so a record whose session is
# gone is never revisited and would otherwise stay in context forever.
mark_dead_workspaces() {
  local live_sessions=$1 dir meta session
  for dir in "$WORKSPACES_DIR"/*; do
    [ -d "$dir" ] || continue
    meta="$dir/meta"
    [ -f "$meta" ] || continue
    session=$(meta_get "$meta" session)
    if printf '%s\n' "$live_sessions" | grep -Fxq -- "$session"; then
      continue
    fi
    [ "$(meta_get "$meta" live)" != no ] || continue
    meta_set "$meta" live no
    meta_set "$meta" updated_at "$(now)"
  done
}

scan_workspaces() {
  local fmt row session root live_sessions
  fmt=$'#{session_name}\t#{session_path}'
  while IFS= read -r row; do
    IFS=$'\t' read -r session root <<< "$row"
    if [ ! -d "$root" ]; then
      root=$(recorded_workspace_root "$session" 2>/dev/null || true)
    fi
    if [ ! -d "$root" ]; then
      root=$(inventory | awk -F '\t' -v s="$session" '$1 == s && $5 != "" { print $5; exit }')
    fi
    [ -d "$root" ] || continue
    record_workspace "$session" "$(refine_workspace_root "$session" "$root")" yes
  done < <(tmux_cmd list-sessions -F "$fmt")
  live_sessions=$(tmux_cmd list-sessions -F '#{session_name}')
  mark_dead_workspaces "$live_sessions"
}

recorded_workspace_root() {
  local wanted=$1 dir meta root
  for dir in "$WORKSPACES_DIR"/*; do
    [ -d "$dir" ] || continue
    meta="$dir/meta"
    [ -f "$meta" ] || continue
    [ "$(meta_get "$meta" session)" = "$wanted" ] || continue
    root=$(meta_get "$meta" root)
    [ -d "$root" ] || return 1
    printf '%s\n' "$root"
    return 0
  done
  return 1
}

resolve_session_root() {
  local session=$1 root=
  # The trailing colon is required: display-message takes a pane target, and the
  # exact-match "=name" form without it resolves to nothing and exits 0.
  root=$(tmux_cmd display-message -p -t "=$session:" '#{session_path}' 2>/dev/null || true)
  if [ ! -d "$root" ]; then
    root=$(recorded_workspace_root "$session" 2>/dev/null || true)
  fi
  if [ ! -d "$root" ]; then
    root=$(inventory | awk -F '\t' -v s="$session" '$1 == s && $5 != "" { print $5; exit }')
  fi
  [ -d "$root" ] || return 1
  refine_workspace_root "$session" "$root"
}

pane_snapshot() {
  local pane=$1 fmt out
  # An empty tmux target resolves to the caller's own pane, so an unset pane id
  # must never reach tmux. Otherwise a lookup failure turns into the controller
  # inspecting, or typing into, itself.
  [ -n "$pane" ] || return 1
  fmt=$'#{session_name}\t#{window_name}\t#{pane_current_path}\t#{pane_current_command}\t#{pane_pid}'
  out=$(tmux_cmd display-message -p -t "$pane" "$fmt" 2>/dev/null) || return 1
  # A stale pane id makes display-message print empty fields and still exit 0,
  # so an empty first field is the only reliable signal that the pane is gone.
  case "$out" in ''|$'\t'*) return 1 ;; esac
  printf '%s\n' "$out"
}

# Print the pane a record names when that pane is live AND still the one the
# record was written for. A pane id alone can name a different pane after a
# tmux server restart, and must never be typed into on that basis.
record_live_pane() {
  local meta=$1 pane snap pid
  pane=$(meta_get "$meta" pane_id)
  snap=$(pane_snapshot "$pane") || return 1
  pid=${snap##*$'\t'}
  record_on_this_server "$meta" "$pid" || return 1
  printf '%s\n' "$pane"
}

cmd_init() {
  ensure_home
  printf 'initialized %s\n' "$EGO_HOME"
}

cmd_register() {
  [ $# -ge 1 ] || die "register requires a tmux window"
  local selector=$1 id= root= agent=
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --id) [ $# -ge 2 ] || die "--id requires a value"; id=$2; shift 2 ;;
      --root) [ $# -ge 2 ] || die "--root requires a value"; root=$2; shift 2 ;;
      --agent) [ $# -ge 2 ] || die "--agent requires a value"; agent=$2; shift 2 ;;
      *) die "unknown register option '$1'" ;;
    esac
  done
  # An omitted --agent must not overwrite a type Agent Navigator already
  # detected, so the override stays empty rather than defaulting to unknown.
  [ -z "$agent" ] || valid_agent "$agent" || die "unsupported agent type '$agent'"
  ensure_home
  # Pre-check the explicit session:window form so a refused register leaves no
  # record behind. A bare window name still has to be resolved first.
  case "$selector" in *:*) require_in_scope "${selector%%:*}" ;; esac
  id=$(register_target "$selector" "$id" "$root" "$agent")
  require_in_scope "$(agent_session "$id")"
  append_event registered "$id" "$selector" "$(agent_session "$id")"
  printf 'registered %s\n' "$id"
}

agent_navigator_path() {
  local candidate
  if [ -n "${EGO_AGENT_NAVIGATOR:-}" ]; then
    [ -x "$EGO_AGENT_NAVIGATOR" ] || return 1
    printf '%s\n' "$EGO_AGENT_NAVIGATOR"
    return 0
  fi
  for candidate in \
    "$HOME/.local/share/agent-navigator/bin/agent-navigator" \
    "$HOME/Work/tmuxShi/agent-navigator/bin/agent-navigator"; do
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

# Agent Navigator calls bare tmux, which follows $TMUX. Point it at the same
# server Ego inspects so pane IDs from an isolated socket never collide with
# the default server's panes.
run_agent_navigator() {
  local socket_path
  if [ -n "${EGO_TMUX_SOCKET:-}" ]; then
    socket_path=$(tmux_cmd display-message -p '#{socket_path}') || return 1
    TMUX="$socket_path,0,0" "$@"
  else
    "$@"
  fi
}

agent_id_for_pane() {
  local pane=$1 pid=${2:-} dir meta
  for dir in "$AGENTS_DIR"/*; do
    [ -d "$dir" ] || continue
    meta="$dir/meta"
    [ -f "$meta" ] || continue
    [ "$(meta_get "$meta" pane_id)" = "$pane" ] || continue
    # A record from an earlier tmux server names another pane that happened to
    # get this id. Reusing it would hand that record's history to a new agent.
    record_on_this_server "$meta" "$pid" || continue
    meta_get "$meta" id
    return 0
  done
  return 1
}

# The id for a newly seen pane: session--window, then a pane-index suffix, then
# a counter, so a new record never lands on top of an existing one.
mint_agent_id() {
  local session=$1 window=$2 pane_index=$3 id n=2
  id=$(clean_id "$session--$window")
  [ -e "$AGENTS_DIR/$id" ] || { printf '%s\n' "$id"; return 0; }
  id=$(clean_id "$session--$window--p$pane_index")
  while [ -e "$AGENTS_DIR/$id" ]; do
    id=$(clean_id "$session--$window--p$pane_index-$n")
    n=$((n + 1))
  done
  printf '%s\n' "$id"
}

# Join the tmux server with the records. With strict=1 a missing or failing
# Agent Navigator is an error; otherwise detection is skipped with a warning and
# only liveness is updated, so a context read never fails because of it. Counts
# land in SCAN_DETECTED, SCAN_RETIRED, and SCAN_NEW.
SCAN_DETECTED=0
SCAN_RETIRED=0
SCAN_NEW=0
scan_fleet() {
  local strict=${1:-1}
  local all_rows navigator= detected= row session window pane pane_index pane_pid id agent observed controllers= count=0 retired=0 adopted=0 created=0 dir meta existing_pane detected_panes= detection=1
  scan_workspaces

  # A controller record is retired the same way an agent record is, and liveness
  # goes through pane_snapshot, which handles the tmux empty-output trap.
  for dir in "$CONTROLLERS_DIR"/*; do
    [ -d "$dir" ] || continue
    meta="$dir/meta"
    [ -f "$meta" ] || continue
    [ "$(meta_get "$meta" active)" != no ] || continue
    if ! record_live_pane "$meta" >/dev/null; then
      retire_controller_record "$meta" || true
    fi
  done

  all_rows=$(inventory)

  for dir in "$AGENTS_DIR"/*; do
    [ -d "$dir" ] || continue
    meta="$dir/meta"
    [ -f "$meta" ] || continue
    existing_pane=$(meta_get "$meta" pane_id)
    row=$(printf '%s\n' "$all_rows" | awk -F '\t' -v p="$existing_pane" '$4 == p { print; exit }')
    # A pane id is never reused within one server's lifetime, so an absent pane
    # is permanently gone. After a server restart the same id can name a new
    # pane, which must not inherit this record: retire it instead of refreshing.
    if [ -z "$row" ] || ! record_on_this_server "$meta" "$(printf '%s' "$row" | cut -f9)"; then
      if retire_agent_record "$meta"; then
        retired=$((retired + 1))
      fi
      continue
    fi
    id=$(meta_get "$meta" id)
    record_agent "$id" "$row" >/dev/null
  done

  if ! navigator=$(agent_navigator_path); then
    [ "$strict" -eq 0 ] || die "Agent Navigator is not installed; set EGO_AGENT_NAVIGATOR to its executable"
    printf 'warning: Agent Navigator is not installed; new agents were not detected\n' >&2
    detection=0
  elif ! detected=$(run_agent_navigator "$navigator" list); then
    [ "$strict" -eq 0 ] || die "Agent Navigator could not inspect the tmux server"
    printf 'warning: Agent Navigator failed; new agents were not detected\n' >&2
    detection=0
  fi
  controllers=$(active_controller_panes)
  while IFS=$'\t' read -r pane agent observed _; do
    [ -n "$pane" ] || continue
    if [ -n "$controllers" ] && printf '%s\n' "$controllers" | grep -Fxq -- "$pane"; then
      continue
    fi
    row=$(printf '%s\n' "$all_rows" | awk -F '\t' -v p="$pane" '$4 == p { print; exit }')
    [ -n "$row" ] || continue
    IFS=$'\t' read -r session window _ _ _ _ _ pane_index pane_pid _ <<< "$row"
    if id=$(agent_id_for_pane "$pane" "$pane_pid"); then
      :
    else
      id=$(mint_agent_id "$session" "$window" "$pane_index")
      created=$((created + 1))
    fi
    record_agent "$id" "$row" "" "" "$agent" >/dev/null
    meta="$AGENTS_DIR/$id/meta"
    meta_set "$meta" observed_state "$observed"
    detected_panes="$detected_panes$pane"$'\n'
    count=$((count + 1))
  done <<< "$detected"

  # A pane can outlive the agent that ran in it, and a new agent can start in the
  # same pane later. Record whether a process is running instead of retiring the
  # record, so a restarted agent needs no re-registration.
  for dir in "$AGENTS_DIR"/*; do
    [ "$detection" -eq 1 ] || break
    [ -d "$dir" ] || continue
    meta="$dir/meta"
    [ -f "$meta" ] || continue
    if printf '%s' "$detected_panes" | grep -Fxq -- "$(meta_get "$meta" pane_id)" \
      && record_on_this_server "$meta"; then
      meta_set "$meta" process yes
    else
      meta_set "$meta" process no
    fi
  done
  adopted=$(enforce_controller_panes)
  retired=$((retired + adopted))
  SCAN_DETECTED=$count
  SCAN_RETIRED=$retired
  SCAN_NEW=$created
  # A scan that changed nothing is not news. Logging every one filled the event
  # log with routine lines once every context read began with a scan.
  if [ "$retired" -gt 0 ] || [ "$created" -gt 0 ]; then
    append_event scan fleet "$count detected agent panes, $created new, $retired retired" ''
  fi
}

cmd_scan() {
  require_tmux
  ensure_home
  scan_fleet 1
  if [ "$SCAN_RETIRED" -gt 0 ]; then
    printf 'registered or refreshed %s detected agent panes; retired %s whose pane is gone\n' "$SCAN_DETECTED" "$SCAN_RETIRED"
  else
    printf 'registered or refreshed %s detected agent panes\n' "$SCAN_DETECTED"
  fi
}


cmd_controllers() {
  ensure_home
  local dir meta pane live
  printf 'ID\tSESSION\tSCOPE\tACTIVE\tSTATE\tROOT\n'
  for dir in "$CONTROLLERS_DIR"/*; do
    [ -d "$dir" ] || continue
    meta="$dir/meta"
    [ -f "$meta" ] || continue
    pane=$(meta_get "$meta" pane_id)
    live=missing
    if command -v tmux >/dev/null 2>&1 && tmux_cmd list-sessions >/dev/null 2>&1 \
      && record_live_pane "$meta" >/dev/null 2>&1; then
      live=live
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(meta_get "$meta" id)" "$(meta_get "$meta" session)" \
      "$(meta_get "$meta" scope)" "$(meta_get "$meta" active)" "$live" "$(meta_get "$meta" root)"
  done
}

# The older name for 'ego scope'. With no --scope it widens to every session
# live right now; --scope session narrows to the controller's own session.
cmd_promote() {
  local id= scope=server
  while [ $# -gt 0 ]; do
    case "$1" in
      --scope) [ $# -ge 2 ] || die "--scope requires a value"; scope=$2; shift 2 ;;
      --*) die "unknown promote option '$1'" ;;
      *) [ -z "$id" ] || die "promote accepts one controller id"; id=$1; shift ;;
    esac
  done
  if [ -n "$id" ]; then cmd_scope "$id" "$scope"; else cmd_scope "$scope"; fi
}

# Decide whether one workspace record belongs in startup context: a workspace is
# in context while its tmux session is live. A record whose session is gone
# stays readable through 'ego list --workspaces' and 'ego context --full'.
workspace_in_context() {
  local meta=$1 filter=$2
  [ "$(meta_get "$meta" live)" != no ] || return 1
  in_session_list "$(meta_get "$meta" session)" "$filter" || return 1
  return 0
}

print_workspace_table() {
  local active_only=${1:-} filter=${2:-} dir meta live
  printf 'SESSION\tKIND\tLIVE\tROOT\n'
  for dir in "$WORKSPACES_DIR"/*; do
    [ -d "$dir" ] || continue
    meta="$dir/meta"
    [ -f "$meta" ] || continue
    if [ "$active_only" = active ]; then
      workspace_in_context "$meta" "$filter" || continue
    elif ! in_session_list "$(meta_get "$meta" session)" "$filter"; then
      continue
    fi
    live=$(meta_get "$meta" live)
    [ -n "$live" ] || live=unknown
    printf '%s\t%s\t%s\t%s\n' "$(meta_get "$meta" session)" "$(meta_get "$meta" kind)" \
      "$live" "$(meta_get "$meta" root)"
  done
}

print_agent_table() {
  local active_only=${1:-} filter=${2:-} dir meta id pane owner reporting origin active session window cwd command agent live process snap
  printf 'ID\tOWNER\tREPORTING\tORIGIN\tSTATE\tPROCESS\tAGENT\tTARGET\tCWD\tCOMMAND\n'
  for dir in "$AGENTS_DIR"/*; do
    [ -d "$dir" ] || continue
    meta="$dir/meta"
    [ -f "$meta" ] || continue
    active=$(meta_get "$meta" active)
    [ "$active_only" != active ] || [ "$active" != no ] || continue
    session=$(meta_get "$meta" session)
    in_session_list "$session" "$filter" || continue
    id=$(meta_get "$meta" id)
    pane=$(meta_get "$meta" pane_id)
    owner=$(meta_get "$meta" owner)
    reporting=$(meta_get "$meta" reporting)
    [ -n "$reporting" ] || reporting=unknown
    origin=$(meta_get "$meta" origin)
    [ -n "$origin" ] || origin=human
    agent=$(meta_get "$meta" agent)
    window=$(meta_get "$meta" window)
    live=missing
    process=$(meta_get "$meta" process)
    [ -n "$process" ] || process=unknown
    cwd=$(meta_get "$meta" cwd)
    command=$(meta_get "$meta" command)
    if snap=$(pane_snapshot "$pane") && record_on_this_server "$meta" "${snap##*$'\t'}"; then
      live=live
      IFS=$'\t' read -r _ _ cwd command _ <<< "$snap"
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s:%s\t%s\t%s\n' "$id" "$owner" "$reporting" "$origin" \
      "$live" "$process" "$agent" "$session" "$window" "$cwd" "$command"
  done
}

# Why an active record is a cleanup candidate, or nothing when it is not. A
# record whose pane is gone is retired by the next scan on its own; one whose
# pane is open with no agent running is never retired automatically.
stale_reason() {
  local meta=$1
  if ! record_live_pane "$meta" >/dev/null; then
    printf 'pane gone\n'
  elif [ "$(meta_get "$meta" process)" = no ]; then
    printf 'no agent process\n'
  fi
}

print_stale_table() {
  local filter=${1:-} dir meta reason close
  printf 'ID\tREASON\tTARGET\tCLOSE\n'
  for dir in "$AGENTS_DIR"/*; do
    [ -d "$dir" ] || continue
    meta="$dir/meta"
    [ -f "$meta" ] || continue
    [ "$(meta_get "$meta" active)" != no ] || continue
    in_session_list "$(meta_get "$meta" session)" "$filter" || continue
    reason=$(stale_reason "$meta")
    [ -n "$reason" ] || continue
    # Ego never closes a window itself; this is the command Sandro would run.
    close=-
    [ "$reason" = 'pane gone' ] || close="tmux kill-window -t $(meta_get "$meta" window_id)"
    printf '%s\t%s\t%s:%s\t%s\n' "$(meta_get "$meta" id)" "$reason" \
      "$(meta_get "$meta" session)" "$(meta_get "$meta" window)" "$close"
  done
}

cmd_list() {
  ensure_home
  local what=agents active_only= filter=
  while [ $# -gt 0 ]; do
    case "$1" in
      active) active_only=active; shift ;;
      --session) [ $# -ge 2 ] || die "--session requires a value"; filter=$2; shift 2 ;;
      --stale) what=stale; shift ;;
      --controllers) what=controllers; shift ;;
      --workspaces) what=workspaces; shift ;;
      *) die "unknown list option '$1'" ;;
    esac
  done
  case "$what" in
    agents) print_agent_table "$active_only" "$filter" ;;
    stale) print_stale_table "$filter" ;;
    controllers) cmd_controllers ;;
    workspaces) print_workspace_table "$active_only" "$filter" ;;
  esac
}

cmd_context() {
  ensure_home
  local filter= chosen=0 all=0 full=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --session) [ $# -ge 2 ] || die "--session requires a value"; filter=$2; chosen=1; shift 2 ;;
      --all) all=1; chosen=1; shift ;;
      --full) full=1; shift ;;
      *) die "unknown context option '$1'" ;;
    esac
  done
  # Every read starts from a fresh join of tmux and the records, so a dead pane
  # never reaches context just because nobody ran 'ego scan'.
  if command -v tmux >/dev/null 2>&1 && tmux_cmd list-sessions >/dev/null 2>&1; then
    scan_fleet 0 >/dev/null
  fi
  if [ "$chosen" -eq 0 ]; then
    filter=$(scope_sessions)
  elif [ "$all" -eq 1 ]; then
    filter=
  fi
  printf '# Sandro\x27s Ego context\n\nGenerated: %s\n' "$(now)"
  if [ "$(printf '%s\n' "$filter" | grep -c .)" -gt 1 ]; then
    printf 'Scope: sessions %s. Run `ego context --all` for every session on this server.\n\n' "$(session_list_text "$filter")"
  elif [ -n "$filter" ]; then
    printf 'Scope: session %s. Run `ego context --all` for every session on this server.\n\n' "$filter"
  else
    printf 'Scope: every session on this tmux server.\n\n'
  fi
  printf '## Workspaces\n\n'
  print_workspace_table active "$filter"
  local workspace_dir checkpoint
  for workspace_dir in "$WORKSPACES_DIR"/*; do
    [ -d "$workspace_dir" ] || continue
    [ -f "$workspace_dir/meta" ] || continue
    workspace_in_context "$workspace_dir/meta" "$filter" || continue
    checkpoint="$workspace_dir/checkpoint.md"
    [ -f "$checkpoint" ] || continue
    printf '\n'
    cat "$checkpoint"
  done
  printf '\n## Agents\n\n'
  print_agent_table active "$filter"
  local dir meta id owner reporting active handoff status
  for dir in "$AGENTS_DIR"/*; do
    [ -d "$dir" ] || continue
    meta="$dir/meta"
    [ -f "$meta" ] || continue
    active=$(meta_get "$meta" active)
    [ "$active" != no ] || continue
    in_session_list "$(meta_get "$meta" session)" "$filter" || continue
    id=$(meta_get "$meta" id)
    owner=$(meta_get "$meta" owner)
    reporting=$(meta_get "$meta" reporting)
    [ -n "$reporting" ] || reporting=unknown
    handoff="$dir/handoff.md"
    status="$dir/status.log"
    [ "$owner" = ego ] || [ -f "$status" ] || [ -f "$handoff" ] || continue
    printf '\n## Tracked agent: %s\n\n' "$id"
    printf 'Owner: %s\nReporting: %s\n' "$owner" "$reporting"
    if [ "$owner" = ego ] && [ -f "$handoff" ]; then
      printf '\n'
      sed -n '1,160p' "$handoff"
    fi
    if [ -f "$status" ]; then
      printf '\nRecent status:\n'
      tail -n 5 "$status"
    fi
  done
  if [ "$full" -eq 1 ]; then
    # The recovery view adds workspace records whose session is gone, their
    # latest checkpoint, and each agent's endpoint.
    printf '\n'
    if [ -z "$filter" ]; then
      cmd_recover
    else
      local recover_session
      while IFS= read -r recover_session; do
        [ -z "$recover_session" ] || cmd_recover "$recover_session" 2>/dev/null || true
      done <<< "$filter"
    fi
  fi
}

write_workspace_checkpoint() {
  local session=$1 summary=$2 next=$3 mode=$4 id dir meta
  id=$(clean_id "$session")
  dir="$WORKSPACES_DIR/$id"
  meta="$dir/meta"
  [ -f "$meta" ] || die "unknown workspace '$session'; run 'ego scan' first"
  {
    printf '# Workspace checkpoint\n\n'
    printf 'Session: %s\n' "$session"
    printf 'Root: %s\n' "$(meta_get "$meta" root)"
    printf 'Kind: %s\n' "$(meta_get "$meta" kind)"
    printf 'Updated: %s\n' "$(now)"
    printf 'Mode: %s\n\n' "$mode"
    printf '## Current state\n\n%s\n' "$summary"
    if [ -n "$next" ]; then
      printf '\n## Next action\n\n%s\n' "$next"
    fi
  } > "$dir/checkpoint.md"
}

parse_workspace_note() {
  WORKSPACE_SESSION=${1:-}
  [ -n "$WORKSPACE_SESSION" ] || die "$WORKSPACE_ACTION requires a session"
  shift
  WORKSPACE_SUMMARY=
  WORKSPACE_NEXT=
  while [ $# -gt 0 ]; do
    case "$1" in
      --summary) [ $# -ge 2 ] || die "--summary requires text"; WORKSPACE_SUMMARY=$2; shift 2 ;;
      --next) [ $# -ge 2 ] || die "--next requires text"; WORKSPACE_NEXT=$2; shift 2 ;;
      *) die "unknown $WORKSPACE_ACTION option '$1'" ;;
    esac
  done
  [ -n "$WORKSPACE_SUMMARY" ] || die "$WORKSPACE_ACTION requires --summary"
}

cmd_checkpoint() {
  WORKSPACE_ACTION=checkpoint
  parse_workspace_note "$@"
  require_in_scope "$WORKSPACE_SESSION"
  scan_workspaces
  write_workspace_checkpoint "$WORKSPACE_SESSION" "$WORKSPACE_SUMMARY" "$WORKSPACE_NEXT" checkpoint
  append_event checkpoint "$WORKSPACE_SESSION" "$WORKSPACE_SUMMARY" "$WORKSPACE_SESSION"
  printf 'checkpointed workspace %s\n' "$WORKSPACE_SESSION"
}

cmd_stow() {
  WORKSPACE_ACTION=stow
  parse_workspace_note "$@"
  require_in_scope "$WORKSPACE_SESSION"
  scan_workspaces
  write_workspace_checkpoint "$WORKSPACE_SESSION" "$WORKSPACE_SUMMARY" "$WORKSPACE_NEXT" stow
  append_event stow "$WORKSPACE_SESSION" "$WORKSPACE_SUMMARY" "$WORKSPACE_SESSION"
  printf 'stowed workspace %s\n' "$WORKSPACE_SESSION"
}

# Resolve an agent reference to a record id: an id, session:window, or a bare
# window name in the caller's own tmux session. A trailing colon names a whole
# workspace, not an agent, so it resolves to nothing here.
resolve_agent_ref() {
  local ref=$1 current
  case "$ref" in
    ''|*:) return 1 ;;
    *:*) agent_id_in_session "${ref%%:*}" "${ref#*:}"; return ;;
  esac
  if valid_id "$ref" && [ -f "$AGENTS_DIR/$ref/meta" ]; then
    printf '%s\n' "$ref"
    return 0
  fi
  current=$(current_tmux_session 2>/dev/null) || return 1
  agent_id_in_session "$current" "$ref"
}

# Retire records: one agent, every agent in a workspace (session:), every
# cleanup candidate in scope (--stale), or one controller (--controller). A
# retired record leaves context and stays on disk; nothing here closes a window
# or deletes a file. 'register' or 'spawn' brings an agent record back.
cmd_retire() {
  local target= stale=0 controller= filter= id meta session dir sessions count=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --stale) stale=1; shift ;;
      --controller) [ $# -ge 2 ] || die "--controller requires an id"; controller=$2; shift 2 ;;
      --session) [ $# -ge 2 ] || die "--session requires a value"; filter=$2; shift 2 ;;
      --*) die "unknown retire option '$1'" ;;
      *) [ -z "$target" ] || die "retire accepts one target"; target=$1; shift ;;
    esac
  done
  ensure_home
  if [ -n "$controller" ]; then
    valid_id "$controller" || die "invalid controller id '$controller'"
    meta=$(controller_meta "$controller") || die "unknown controller '$controller'; run 'ego list --controllers'"
    session=$(meta_get "$meta" session)
    require_in_scope "$session"
    if retire_controller_record "$meta"; then
      append_event controller-retired "$controller" "record retired" "$session"
      printf 'retired controller %s\n' "$controller"
    else
      printf 'controller %s was already retired\n' "$controller"
    fi
    return 0
  fi
  if [ "$stale" -eq 1 ]; then
    [ -z "$target" ] || die "retire --stale takes no target; use --session to narrow it"
    [ -z "$filter" ] || require_in_scope "$filter"
    sessions=$(scope_sessions)
    for dir in "$AGENTS_DIR"/*; do
      [ -d "$dir" ] || continue
      meta="$dir/meta"
      [ -f "$meta" ] || continue
      [ "$(meta_get "$meta" active)" != no ] || continue
      session=$(meta_get "$meta" session)
      [ -z "$filter" ] || [ "$session" = "$filter" ] || continue
      if [ -n "$sessions" ] && ! printf '%s\n' "$sessions" | grep -Fxq -- "$session"; then
        continue
      fi
      [ -n "$(stale_reason "$meta")" ] || continue
      if retire_agent_record "$meta"; then
        count=$((count + 1))
      fi
    done
    append_event retired "${filter:-fleet}" "$count stale agent records retired" "$filter"
    printf 'retired %s stale agent records\n' "$count"
    return 0
  fi
  [ -n "$target" ] || die "retire requires an agent, a session: workspace, --stale, or --controller"
  case "$target" in
    *:)
      session=${target%:}
      [ -n "$session" ] || die "retire requires a session name before the colon"
      require_in_scope "$session"
      for dir in "$AGENTS_DIR"/*; do
        [ -d "$dir" ] || continue
        meta="$dir/meta"
        [ -f "$meta" ] || continue
        [ "$(meta_get "$meta" session)" = "$session" ] || continue
        if retire_agent_record "$meta"; then
          count=$((count + 1))
        fi
      done
      append_event workspace-retired "$session" "$count agent records retired" "$session"
      printf 'retired %s agent records in workspace %s\n' "$count" "$session"
      ;;
    *)
      id=$(resolve_agent_ref "$target") \
        || die "unknown agent '$target'; pass its id, session:window, or a window in this session"
      meta=$(agent_meta "$id")
      session=$(meta_get "$meta" session)
      require_in_scope "$session"
      if retire_agent_record "$meta"; then
        append_event retired "$id" "record retired" "$session"
        printf 'retired %s; its records remain on disk\n' "$id"
      else
        printf '%s was already retired\n' "$id"
      fi
      ;;
  esac
}

# The single delete in Ego. It removes Ego's own record of an agent whose pane is
# already gone, never a window, a directory, or a worktree.
cmd_purge() {
  [ $# -eq 1 ] || die "purge requires one agent id"
  local id=$1 meta session
  valid_id "$id" || die "invalid agent id '$id'"
  ensure_home
  meta=$(agent_meta "$id")
  session=$(meta_get "$meta" session)
  require_in_scope "$session"
  if command -v tmux >/dev/null 2>&1 && tmux_cmd list-sessions >/dev/null 2>&1 \
    && record_live_pane "$meta" >/dev/null 2>&1; then
    die "agent '$id' still has a live pane; retire it instead, or close its window first"
  fi
  rm -rf -- "${meta%/meta}"
  append_event purged "$id" "record purged" "$session"
  printf 'purged the record for %s\n' "$id"
}

cmd_handoff_workspace() {
  WORKSPACE_ACTION=handoff-workspace
  parse_workspace_note "$@"
  require_in_scope "$WORKSPACE_SESSION"
  cmd_scan >/dev/null
  write_workspace_checkpoint "$WORKSPACE_SESSION" "$WORKSPACE_SUMMARY" "$WORKSPACE_NEXT" handoff
  local dir meta session count=0 summary_lines=
  for dir in "$AGENTS_DIR"/*; do
    [ -d "$dir" ] || continue
    meta="$dir/meta"
    [ -f "$meta" ] || continue
    session=$(meta_get "$meta" session)
    [ "$session" = "$WORKSPACE_SESSION" ] || continue
    [ "$(meta_get "$meta" active)" != no ] || continue
    # Each agent's own note carries the workspace summary and its live state.
    {
      printf '# Handoff\n\n'
      printf 'Updated: %s\n' "$(now)"
      printf 'Handed off with workspace %s.\n\n' "$WORKSPACE_SESSION"
      printf '## Current state\n\n%s\n' "$WORKSPACE_SUMMARY"
      if [ -n "$WORKSPACE_NEXT" ]; then
        printf '\n## Next action\n\n%s\n' "$WORKSPACE_NEXT"
      fi
      printf '\n'
      worker_state_section "$meta"
    } > "$dir/handoff.md"
    meta_set "$meta" owner ego
    meta_set "$meta" updated_at "$(now)"
    summary_lines="$summary_lines$(meta_get "$meta" id): process=$(meta_get "$meta" process), latest report: $(if [ -s "$dir/status.log" ]; then tail -n 1 "$dir/status.log" | cut -f2-3 | tr '\t' ' '; else printf none; fi)"$'\n'
    count=$((count + 1))
  done
  append_event workspace-handoff "$WORKSPACE_SESSION" "$WORKSPACE_SUMMARY" "$WORKSPACE_SESSION"
  printf 'handed workspace %s and %s registered agents to Ego\n' "$WORKSPACE_SESSION" "$count"
  [ -z "$summary_lines" ] || printf '%s' "$summary_lines"
}

cmd_recover() {
  ensure_home
  local wanted=${1:-} dir meta session checkpoint archived_checkpoint found=0 tmux_available=0
  if command -v tmux >/dev/null 2>&1 && tmux_cmd list-sessions >/dev/null 2>&1; then
    tmux_available=1
  fi
  printf '# Recovery view\n\n'
  for dir in "$WORKSPACES_DIR"/*; do
    [ -d "$dir" ] || continue
    meta="$dir/meta"
    [ -f "$meta" ] || continue
    session=$(meta_get "$meta" session)
    [ -z "$wanted" ] || [ "$wanted" = "$session" ] || continue
    found=1
    printf '## %s\n\n' "$session"
    cat "$meta"
    checkpoint="$dir/checkpoint.md"
    if [ -f "$checkpoint" ]; then
      printf '\n'
      cat "$checkpoint"
    else
      archived_checkpoint=$(find "$dir/archive" -type f -name '*.md' 2>/dev/null | LC_ALL=C sort | tail -n 1)
      if [ -n "$archived_checkpoint" ]; then
        printf '\nLatest archived checkpoint:\n\n'
        cat "$archived_checkpoint"
      else
        printf '\nNo workspace checkpoint has been written.\n'
      fi
    fi
    printf '\nAgents in this workspace:\n'
    local agent_dir agent_meta_file pane endpoint
    for agent_dir in "$AGENTS_DIR"/*; do
      [ -d "$agent_dir" ] || continue
      agent_meta_file="$agent_dir/meta"
      [ -f "$agent_meta_file" ] || continue
      [ "$(meta_get "$agent_meta_file" session)" = "$session" ] || continue
      pane=$(meta_get "$agent_meta_file" pane_id)
      endpoint=unavailable
      if [ "$tmux_available" -eq 1 ]; then
        if record_live_pane "$agent_meta_file" >/dev/null; then endpoint=live; else endpoint=missing; fi
      fi
      printf '%s owner=%s agent=%s window=%s endpoint=%s\n' \
        "$(meta_get "$agent_meta_file" id)" "$(meta_get "$agent_meta_file" owner)" \
        "$(meta_get "$agent_meta_file" agent)" "$(meta_get "$agent_meta_file" window)" "$endpoint"
    done
    printf '\n'
  done
  [ "$found" -eq 1 ] || die "no recorded workspace matches '${wanted:-any session}'"
}

# What a worker is doing right now, captured mechanically so a handoff note is
# complete even when its summary does not mention a running process. Reads only
# Ego's records and the pane; it never types into the pane.
worker_state_section() {
  local meta=$1 lines=${2:-20} dir status latest pending=0 pane process observed file
  dir=${meta%/meta}
  status="$dir/status.log"
  printf '## Worker state at handoff\n\n'
  printf 'Captured: %s\n' "$(now)"
  if [ -s "$status" ]; then
    latest=$(tail -n 1 "$status" | tr '\t' ' ')
    printf 'Latest report: %s\n' "$latest"
  else
    printf 'Latest report: none recorded\n'
  fi
  process=$(meta_get "$meta" process)
  observed=$(meta_get "$meta" observed_state)
  printf 'Agent process: %s\n' "${process:-unknown}"
  printf 'Observed screen: %s\n' "${observed:-unknown}"
  printf 'Reporting: %s\n' "$(meta_get "$meta" reporting)"
  for file in "$dir/inbox"/*.msg; do
    [ -f "$file" ] || continue
    pending=$((pending + 1))
  done
  printf 'Pending inbox messages: %s\n' "$pending"
  if pane=$(record_live_pane "$meta"); then
    printf '\nLast %s pane lines:\n\n````text\n' "$lines"
    # Trailing blank rows are empty screen, not output.
    tmux_cmd capture-pane -p -J -t "$pane" -S "-$lines" 2>/dev/null \
      | awk -v n="$lines" '{ rows[NR] = $0; if ($0 ~ /[^[:space:]]/) last = NR }
          END { first = last - n + 1; if (first < 1) first = 1; for (i = first; i <= last; i++) print rows[i] }'
    printf '````\n'
  else
    printf '\nPane: gone\n'
  fi
}

cmd_handoff() {
  local ref= session= summary= next= id meta dir
  while [ $# -gt 0 ]; do
    case "$1" in
      --session) [ $# -ge 2 ] || die "--session requires a value"; session=$2; shift 2 ;;
      --summary) [ $# -ge 2 ] || die "--summary requires text"; summary=$2; shift 2 ;;
      --next) [ $# -ge 2 ] || die "--next requires text"; next=$2; shift 2 ;;
      --*) die "unknown handoff option '$1'" ;;
      *) [ -z "$ref" ] || die "handoff accepts one agent or window"; ref=$1; shift ;;
    esac
  done
  [ -n "$ref" ] || die "handoff requires an agent id or tmux window"
  [ -n "$summary" ] || die "handoff requires --summary"
  case "$ref" in
    *:)
      [ -z "$session" ] || die "handoff of a whole workspace takes no --session"
      if [ -n "$next" ]; then
        cmd_handoff_workspace "${ref%:}" --summary "$summary" --next "$next"
      else
        cmd_handoff_workspace "${ref%:}" --summary "$summary"
      fi
      return
      ;;
  esac
  ensure_home
  # Check the named session before anything can register a window in it.
  [ -z "$session" ] || require_in_scope "$session"
  case "$ref" in *:*) require_in_scope "${ref%%:*}" ;; esac
  if [ -n "$session" ]; then
    if id=$(agent_id_in_session "$session" "$ref"); then
      :
    else
      id=$(register_target "$session:$ref")
    fi
  elif [ -f "$AGENTS_DIR/$ref/meta" ]; then
    id=$ref
  else
    id=$(register_target "$ref")
  fi
  meta=$(agent_meta "$id")
  require_in_scope "$(meta_get "$meta" session)"
  dir=${meta%/meta}
  # Refresh process and screen observations so the snapshot is current.
  scan_fleet 0 >/dev/null
  {
    printf '# Handoff\n\n'
    printf 'Updated: %s\n\n' "$(now)"
    printf '## Current state\n\n%s\n' "$summary"
    if [ -n "$next" ]; then
      printf '\n## Next action\n\n%s\n' "$next"
    fi
    printf '\n'
    worker_state_section "$meta"
  } > "$dir/handoff.md"
  meta_set "$meta" owner ego
  meta_set "$meta" updated_at "$(now)"
  append_event handoff "$id" "$summary" "$(meta_get "$meta" session)"
  printf 'handed off %s to Ego\n\n' "$id"
  worker_state_section "$meta"
}

cmd_takeback() {
  local ref= session= id meta current=
  while [ $# -gt 0 ]; do
    case "$1" in
      --session) [ $# -ge 2 ] || die "--session requires a value"; session=$2; shift 2 ;;
      --*) die "unknown handback option '$1'" ;;
      *) [ -z "$ref" ] || die "handback accepts one agent or window"; ref=$1; shift ;;
    esac
  done
  [ -n "$ref" ] || die "handback requires an agent id, session:window, or session:"
  case "$ref" in
    *:)
      [ -z "$session" ] || die "handback of a whole workspace takes no --session"
      cmd_takeback_workspace "${ref%:}"
      return
      ;;
  esac
  if [ -n "$session" ]; then
    id=$(agent_id_in_session "$session" "$ref") \
      || die "unknown agent or window '$ref' in session '$session'"
  elif id=$(resolve_agent_ref "$ref"); then
    :
  elif current=$(current_tmux_session); then
    die "unknown agent or window '$ref' in current session '$current'"
  else
    die "unknown agent '$ref'; pass its full id or session:window"
  fi
  meta=$(agent_meta "$id")
  require_in_scope "$(meta_get "$meta" session)"
  meta_set "$meta" owner human
  meta_set "$meta" updated_at "$(now)"
  append_event takeback "$id" "returned to Sandro" "$(meta_get "$meta" session)"
  printf 'returned %s to human control\n' "$id"
  if [ -s "${meta%/meta}/status.log" ]; then
    printf 'latest report: '
    tail -n 1 "${meta%/meta}/status.log"
  else
    printf 'latest report: none recorded\n'
  fi
  printf 'reporting remains %s\n' "$(meta_get "$meta" reporting)"
}

cmd_takeback_workspace() {
  [ $# -eq 1 ] || die "takeback-workspace requires one session"
  local wanted=$1 dir meta session count=0
  require_in_scope "$wanted"
  cmd_scan >/dev/null
  for dir in "$AGENTS_DIR"/*; do
    [ -d "$dir" ] || continue
    meta="$dir/meta"
    [ -f "$meta" ] || continue
    session=$(meta_get "$meta" session)
    [ "$session" = "$wanted" ] || continue
    [ "$(meta_get "$meta" active)" != no ] || continue
    meta_set "$meta" owner human
    meta_set "$meta" updated_at "$(now)"
    count=$((count + 1))
  done
  append_event workspace-takeback "$wanted" "$count agents returned to Sandro" "$wanted"
  printf 'returned workspace %s and %s registered agents to human control\n' "$wanted" "$count"
}

# A worker name is its tmux window name and the tail of its id. Short role names
# such as az-analyzer read at a glance; invented long ones do not.
valid_worker_name() {
  local name=$1 parts
  case "$name" in ''|-*|*-|*--*|*[!a-z0-9-]*) return 1 ;; esac
  [ "${#name}" -le 24 ] || return 1
  parts=$(printf '%s' "$name" | tr -cd '-' | wc -c | tr -d ' ')
  [ "$parts" -le 2 ]
}

cmd_spawn() {
  [ $# -ge 1 ] || die "spawn requires a name"
  local name=$1 session= root= id= brief= command_text= agent=kiro agent_set=0 use_worktree=0 branch= window row pane launch prompt source_root repo_top worktree
  local created_session=0 primary_root=
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --session) [ $# -ge 2 ] || die "--session requires a value"; session=$2; shift 2 ;;
      --root) [ $# -ge 2 ] || die "--root requires a value"; root=$2; shift 2 ;;
      --id) [ $# -ge 2 ] || die "--id requires a value"; id=$2; shift 2 ;;
      --brief) [ $# -ge 2 ] || die "--brief requires text"; brief=$2; shift 2 ;;
      --agent) [ $# -ge 2 ] || die "--agent requires a value"; agent=$2; agent_set=1; shift 2 ;;
      --worktree) use_worktree=1; shift ;;
      --branch) [ $# -ge 2 ] || die "--branch requires a value"; branch=$2; use_worktree=1; shift 2 ;;
      --command) [ $# -ge 2 ] || die "--command requires text"; command_text=$2; shift 2 ;;
      *) die "unknown spawn option '$1'" ;;
    esac
  done
  if [ -n "$command_text" ] && [ "$agent_set" -eq 0 ]; then
    agent=unknown
  fi
  valid_worker_name "$name" \
    || die "worker names are short <topic>-<role> kebab-case, such as az-analyzer or stt-research: lowercase letters, digits, and hyphens, at most 3 parts and 24 characters"
  case "$agent" in
    unknown) ;;
    *) launchable_agent "$agent" || die "--agent must be codex, claude, or kiro" ;;
  esac
  if [ -z "$command_text" ]; then
    [ "$agent" != unknown ] || die "unknown agents require --command"
    command -v "$(agent_executable "$agent")" >/dev/null 2>&1 || die "$(agent_executable "$agent") is not installed"
  fi
  require_tmux
  ensure_home
  if [ -z "$session" ] && [ -n "${TMUX:-}" ]; then
    session=$(tmux_cmd display-message -p '#S')
  fi
  [ -n "$session" ] || die "run spawn inside tmux or pass --session"
  # Checked before anything is created: spawn can otherwise open a window in
  # another workspace. A controller may create a brand-new workspace, which then
  # joins its own scope; a worker may not.
  if tmux_cmd has-session -t "=$session" 2>/dev/null || ! caller_controller_id >/dev/null; then
    require_in_scope "$session"
  fi
  if ! tmux_cmd has-session -t "=$session" 2>/dev/null; then
    valid_id "$session" \
      || die "new session names must be directory-safe; use a name such as 'music-generation'"
    if [ -z "$root" ]; then
      primary_root=$(workspace_option @workspace_primary)
      [ -n "$primary_root" ] \
        || die "tmux session '$session' does not exist and @workspace_primary is not configured; pass --root"
      root="$primary_root/$session"
    fi
    mkdir -p "$root"
    tmux_cmd new-session -d -s "$session" -c "$root"
    record_workspace "$session" "$root"
    append_event workspace-created "$session" "$root" "$session"
    add_session_to_caller_scope "$session"
    created_session=1
  fi
  window=$name
  if inventory | awk -F '\t' -v s="$session" -v w="$window" '$1 == s && $2 == w { found=1 } END { exit !found }'; then
    die "tmux window $session:$window already exists"
  fi
  if [ -z "$root" ]; then
    root=$(resolve_session_root "$session" || true)
  fi
  [ -d "$root" ] \
    || die "cannot determine a directory for tmux session '$session'; pass --root or fix the recorded workspace root"
  id=${id:-$(clean_id "$session--$window")}
  valid_id "$id" || die "invalid agent id '$id'"
  source_root=$root
  worktree=
  if [ "$use_worktree" -eq 1 ]; then
    command -v git >/dev/null 2>&1 || die "git is not installed"
    repo_top=$(git -C "$source_root" rev-parse --show-toplevel 2>/dev/null) \
      || die "worktree root '$source_root' is not inside a Git repository"
    worktree="$WORKTREES_DIR/$id"
    [ ! -e "$worktree" ] || die "worktree path '$worktree' already exists"
    branch=${branch:-ego/$id}
    git check-ref-format --branch "$branch" >/dev/null 2>&1 \
      || die "invalid branch name '$branch'"
    if git -C "$repo_top" show-ref --verify --quiet "refs/heads/$branch"; then
      git -C "$repo_top" worktree add "$worktree" "$branch"
    else
      git -C "$repo_top" worktree add -b "$branch" "$worktree" HEAD
    fi
    root=$worktree
  fi
  tmux_cmd new-window -d -t "=$session:" -n "$window" -c "$root"
  row=$(resolve_target "$session:$window")
  if [ -n "$command_text" ]; then
    record_agent "$id" "$row" "$root" ego "$agent" unknown >/dev/null
  else
    record_agent "$id" "$row" "$root" ego "$agent" on >/dev/null
  fi
  meta_set "$AGENTS_DIR/$id/meta" origin ego
  meta_set "$AGENTS_DIR/$id/meta" active yes
  if [ -n "$worktree" ]; then
    meta_set "$AGENTS_DIR/$id/meta" source_root "$source_root"
    meta_set "$AGENTS_DIR/$id/meta" worktree "$worktree"
    meta_set "$AGENTS_DIR/$id/meta" branch "$branch"
  fi
  printf '%s\n' "$brief" > "$AGENTS_DIR/$id/brief.md"
  launch="$AGENTS_DIR/$id/launch.sh"
  if [ -n "$command_text" ]; then
    {
      printf '#!/bin/zsh\n'
      printf 'export EGO_HOME=%s\n' "$(shell_quote "$EGO_HOME")"
      printf 'export EGO_AGENT_ID=%s\n' "$(shell_quote "$id")"
      printf 'cd %s\n' "$(shell_quote "$root")"
      printf 'exec /bin/zsh -lc %s\n' "$(shell_quote "$command_text")"
    } > "$launch"
  else
    prompt="You are worker $id, tracked through Sandro's Ego. Read $AGENTS_DIR/$id/brief.md. Work in $root. Report material phase changes regardless of who is supervising with: $EGO_CLI_PATH report $id <working|idle|blocked|needs-decision|done|failed|note> <message>. Use idle when no task is assigned. Use done when your assigned scope is complete, even if the broader project has a later external gate. Use blocked only when the assigned scope cannot proceed. Check pending instructions at natural checkpoints with: $EGO_CLI_PATH inbox $id. Acknowledge each handled message with: $EGO_CLI_PATH ack $id <message-id>. Do not claim completion until the requested result is complete."
    {
      printf '#!/bin/zsh\n'
      printf 'export EGO_HOME=%s\n' "$(shell_quote "$EGO_HOME")"
      printf 'export EGO_AGENT_ID=%s\n' "$(shell_quote "$id")"
      launch_exec_line "$agent" "$root" "$prompt"
    } > "$launch"
  fi
  chmod 700 "$launch"
  pane=$(meta_get "$AGENTS_DIR/$id/meta" pane_id)
  tmux_cmd send-keys -t "$pane" "$(shell_quote "$launch")" Enter
  append_event spawned "$id" "$session:$window root=$root${worktree:+ branch=$branch}" "$session"
  if [ "$created_session" -eq 1 ]; then
    printf 'created workspace session %s at %s\n' "$session" "$source_root"
  fi
  printf 'spawned %s at %s:%s\n' "$id" "$session" "$window"
}

cmd_peek() {
  [ $# -ge 1 ] || die "peek requires an agent id"
  local meta pane lines=${2:-80}
  meta=$(agent_meta "$1")
  require_in_scope "$(meta_get "$meta" session)"
  pane=$(meta_get "$meta" pane_id)
  [ -n "$pane" ] || die "agent '$1' has no recorded pane"
  case "$lines" in ''|*[!0-9]*) die "lines must be a positive integer" ;; esac
  pane=$(record_live_pane "$meta") \
    || die "agent '$1' has no live pane; its pane is gone or now belongs to another program, so run 'ego scan'"
  tmux_cmd capture-pane -p -t "$pane" -S "-$lines"
}

queue_message() {
  local id=$1 text=$2 meta pane dir inbox message_id tmp notice buffer ego_cli suffix=0
  meta=$(agent_meta "$id")
  # Callers invoke this through a command substitution, where bash ignores
  # set -e, so a failed lookup has to be checked rather than trusted to abort.
  [ -n "$meta" ] || return 1
  pane=$(record_live_pane "$meta") || return 1
  [ -n "$pane" ] || return 1
  dir=${meta%/meta}
  inbox="$dir/inbox"
  mkdir -p "$inbox/handled"
  message_id="$(date -u '+%Y%m%dT%H%M%SZ')-$$"
  while [ -e "$inbox/$message_id.msg" ]; do
    suffix=$((suffix + 1))
    message_id="$(date -u '+%Y%m%dT%H%M%SZ')-$$-$suffix"
  done
  tmp=$(mktemp "$inbox/.message.XXXXXX")
  printf '%s\n' "$text" > "$tmp"
  mv "$tmp" "$inbox/$message_id.msg"
  ego_cli="EGO_HOME=$(shell_quote "$EGO_HOME") $(shell_quote "$EGO_CLI_PATH")"
  notice="EGO_INBOX: message $message_id is waiting. Read it with: $ego_cli inbox $id"
  buffer="ego-$id-$$"
  # Terminal UIs process a paste asynchronously; an immediate Enter can arrive
  # before the text lands and be dropped, leaving the notice unsubmitted.
  if tmux_cmd set-buffer -b "$buffer" -- "$notice" \
    && tmux_cmd paste-buffer -d -b "$buffer" -t "$pane" \
    && sleep 0.5 \
    && tmux_cmd send-keys -t "$pane" Enter; then
    :
  else
    printf 'warning: message %s is durable, but the pane notice failed\n' "$message_id" >&2
  fi
  printf '%s\n' "$message_id"
}

cmd_send() {
  [ $# -ge 2 ] || die "send requires an agent id and message"
  local id=$1 text meta message_id
  shift
  text=$*
  # Resolve into a variable rather than nesting agent_meta inside another
  # substitution: its 'die' would only exit the inner subshell, and execution
  # would continue with an empty record path.
  meta=$(agent_meta "$id")
  require_in_scope "$(meta_get "$meta" session)"
  message_id=$(queue_message "$id" "$text") \
    || die "could not reach '$id'; its pane may be gone, so run 'ego scan'"
  [ -n "$message_id" ] || die "could not reach '$id'; its pane may be gone, so run 'ego scan'"
  append_event sent "$id" "message=$message_id $text" "$(meta_get "$meta" session)"
  printf 'queued %s for %s\n' "$message_id" "$id"
}

cmd_press() {
  [ $# -eq 2 ] || die "press requires an agent id and one allowed key"
  local id=$1 requested=$2 meta pane key
  meta=$(agent_meta "$id")
  require_in_scope "$(meta_get "$meta" session)"
  pane=$(record_live_pane "$meta") || die "agent '$id' has no live pane"
  [ -n "$pane" ] || die "agent '$id' has no live pane"
  case "$requested" in
    enter) key=Enter ;;
    escape|esc) key=Escape ;;
    y|n|p) key=$requested ;;
    *) die "press key must be enter, escape, y, n, or p" ;;
  esac
  tmux_cmd send-keys -t "$pane" "$key"
  append_event pressed "$id" "$requested" "$(meta_get "$meta" session)"
  printf 'pressed %s for %s\n' "$requested" "$id"
}

cmd_inbox() {
  [ $# -eq 1 ] || die "inbox requires one agent id"
  local meta dir file found=0 message_id
  meta=$(agent_meta "$1")
  dir=${meta%/meta}
  for file in "$dir/inbox"/*.msg; do
    [ -f "$file" ] || continue
    found=1
    message_id=$(basename "$file" .msg)
    printf 'MESSAGE %s\n' "$message_id"
    cat "$file"
  done
  [ "$found" -eq 1 ] || printf 'No pending messages.\n'
}

cmd_ack() {
  [ $# -eq 2 ] || die "ack requires an agent id and message id"
  local meta dir message_id=$2
  case "$message_id" in ''|.*|*/*|*[!A-Za-z0-9._-]*) die "invalid message id '$message_id'" ;; esac
  meta=$(agent_meta "$1")
  dir=${meta%/meta}
  [ -f "$dir/inbox/$message_id.msg" ] || die "pending message '$message_id' does not exist"
  mkdir -p "$dir/inbox/handled"
  mv "$dir/inbox/$message_id.msg" "$dir/inbox/handled/$message_id.msg"
  append_event acknowledged "$1" "$message_id" "$(agent_session "$1")"
  printf 'acknowledged %s for %s\n' "$message_id" "$1"
}

cmd_onboard() {
  [ $# -eq 1 ] || die "onboard requires one agent, session:window, or session:"
  local ref=$1 id meta message message_id ego_cli
  case "$ref" in *:) cmd_onboard_workspace "${ref%:}"; return ;; esac
  ensure_home
  # Onboarding a window Ego has not recorded registers it first, so a window
  # name works here the same way it does for handoff.
  if ! id=$(resolve_agent_ref "$ref"); then
    case "$ref" in *:*) require_in_scope "${ref%%:*}" ;; esac
    id=$(register_target "$ref")
    [ -n "$id" ] || die "no agent or tmux window matches '$ref'"
  fi
  meta=$(agent_meta "$id")
  require_in_scope "$(meta_get "$meta" session)"
  ego_cli="EGO_HOME=$(shell_quote "$EGO_HOME") $(shell_quote "$EGO_CLI_PATH")"
  message="Join Ego's reporting protocol while keeping the current human workflow. Report only material phase changes with: $ego_cli report $id <working|idle|blocked|needs-decision|done|failed|note> <message>. Use idle when no task is assigned. Use done when your assigned scope is complete, even if the broader project has a later external gate. Use blocked only when the assigned scope cannot proceed. Check instructions at natural checkpoints with: $ego_cli inbox $id. Acknowledge each handled instruction with: $ego_cli ack $id <message-id>. Reporting stays active whether owner is human or ego."
  message_id=$(queue_message "$id" "$message") \
    || die "could not reach '$id'; its pane may be gone, so run 'ego scan'"
  [ -n "$message_id" ] || die "could not reach '$id'; its pane may be gone, so run 'ego scan'"
  meta_set "$meta" reporting on
  meta_set "$meta" updated_at "$(now)"
  append_event onboarded "$id" "message=$message_id" "$(meta_get "$meta" session)"
  printf 'onboarded %s with message %s\n' "$id" "$message_id"
}

# The inverse of onboard: the agent stops calling 'ego report'. Its record,
# owner, and history stay; only the reporting contract is withdrawn.
cmd_offboard() {
  [ $# -eq 1 ] || die "offboard requires one agent id or session:window"
  local ref=$1 id meta message message_id
  id=$(resolve_agent_ref "$ref") || die "unknown agent '$ref'"
  meta=$(agent_meta "$id")
  require_in_scope "$(meta_get "$meta" session)"
  message="Leave Ego's reporting protocol. Stop calling ego report and ego inbox for $id. Continue your current work as before."
  message_id=$(queue_message "$id" "$message") \
    || die "could not reach '$id'; its pane may be gone, so run 'ego scan'"
  [ -n "$message_id" ] || die "could not reach '$id'; its pane may be gone, so run 'ego scan'"
  meta_set "$meta" reporting off
  meta_set "$meta" updated_at "$(now)"
  append_event offboarded "$id" "message=$message_id" "$(meta_get "$meta" session)"
  printf 'offboarded %s with message %s\n' "$id" "$message_id"
}

cmd_onboard_workspace() {
  [ $# -eq 1 ] || die "onboard-workspace requires one session"
  local wanted=$1 workspace_dir workspace_meta found=0 dir meta session id pane reporting
  local onboarded=0 already=0 unavailable=0
  require_in_scope "$wanted"
  cmd_scan >/dev/null

  for workspace_dir in "$WORKSPACES_DIR"/*; do
    [ -d "$workspace_dir" ] || continue
    workspace_meta="$workspace_dir/meta"
    [ -f "$workspace_meta" ] || continue
    [ "$(meta_get "$workspace_meta" session)" = "$wanted" ] || continue
    found=1
    break
  done
  [ "$found" -eq 1 ] || die "unknown workspace '$wanted'"

  for dir in "$AGENTS_DIR"/*; do
    [ -d "$dir" ] || continue
    meta="$dir/meta"
    [ -f "$meta" ] || continue
    session=$(meta_get "$meta" session)
    [ "$session" = "$wanted" ] || continue
    [ "$(meta_get "$meta" active)" != no ] || continue
    reporting=$(meta_get "$meta" reporting)
    if [ "$reporting" = on ]; then
      already=$((already + 1))
      continue
    fi
    id=$(meta_get "$meta" id)
    pane=$(meta_get "$meta" pane_id)
    if ! record_live_pane "$meta" >/dev/null; then
      printf 'warning: skipped %s because its pane is unavailable\n' "$id" >&2
      unavailable=$((unavailable + 1))
      continue
    fi
    cmd_onboard "$id" >/dev/null
    onboarded=$((onboarded + 1))
  done

  append_event workspace-onboarded "$wanted" "$onboarded onboarded, $already already reporting, $unavailable unavailable" "$wanted"
  printf 'onboarded %s agents in workspace %s; %s already reporting; %s unavailable\n' \
    "$onboarded" "$wanted" "$already" "$unavailable"
}

cmd_report() {
  [ $# -ge 3 ] || die "report requires an id, state, and message"
  local id=$1 state=$2 meta dir message
  shift 2
  message=$*
  case "$state" in
    investigating|validating) state=working ;;
    waiting) state=idle ;;
    complete|completed) state=done ;;
    error) state=failed ;;
    working|idle|blocked|needs-decision|done|failed|note) ;;
    *) die "invalid state '$state'; run 'ego report --help' for accepted states" ;;
  esac
  meta=$(agent_meta "$id")
  dir=${meta%/meta}
  printf '%s\t%s\t%s\n' "$(now)" "$state" "$(one_line "$message")" >> "$dir/status.log"
  append_event "$state" "$id" "$message" "$(meta_get "$meta" session)"
  printf 'recorded %s for %s\n' "$state" "$id"
}

# One cursor per caller. A shared cursor would let one controller consume an
# event and hide it from another. A controller's own id keys it, so retiring the
# record can clean the cursor up.
watch_cursor_file() {
  local key
  if ! key=$(caller_controller_id); then
    key=${EGO_CONTROLLER_ID:-${TMUX_PANE:-default}}
  fi
  printf '%s/watch/%s.cursor\n' "$EGO_HOME" "$(clean_id "$key")"
}

cmd_watch() {
  local timeout=300 all=0 start lines now_lines total batch matched cursor_file session
  while [ $# -gt 0 ]; do
    case "$1" in
      --all) all=1; shift ;;
      ''|*[!0-9]*) die "watch timeout must be an integer" ;;
      *) timeout=$1; shift ;;
    esac
  done
  case "$timeout" in ''|*[!0-9]*) die "watch timeout must be an integer" ;; esac
  ensure_home
  # Scope is the other axis from --all: a scoped controller wakes for every kind
  # within its own sessions, never for another workspace.
  session=$(scope_sessions | paste -sd, -)
  cursor_file=$(watch_cursor_file)
  mkdir -p "$(dirname "$cursor_file")"
  total=$(wc -l < "$EVENTS_FILE" | tr -d ' ')
  # The first watch on a cursor starts from now so an old log is not replayed.
  # Later calls resume, which surfaces events that landed while the controller
  # was busy instead of dropping them.
  if [ -f "$cursor_file" ]; then
    IFS= read -r lines < "$cursor_file" || lines=0
    case "$lines" in ''|*[!0-9]*) lines=0 ;; esac
    [ "$lines" -le "$total" ] || lines=$total
  else
    lines=$total
  fi
  # Persist immediately: a call that returns without seeing an event must still
  # leave a cursor, or the next call starts from the present all over again.
  printf '%s\n' "$lines" > "$cursor_file"
  start=$SECONDS
  while :; do
    now_lines=$(wc -l < "$EVENTS_FILE" | tr -d ' ')
    if [ "$now_lines" -gt "$lines" ]; then
      batch=$(tail -n "+$((lines + 1))" "$EVENTS_FILE")
      lines=$now_lines
      printf '%s\n' "$lines" > "$cursor_file"
      # A line written before the session field existed has four fields, and a
      # fleet event leaves the field empty. Both match every scope.
      if [ -n "$session" ]; then
        batch=$(printf '%s\n' "$batch" | awk -F '\t' -v s="$session" '
          BEGIN { n = split(s, list, ","); for (i = 1; i <= n; i++) keep[list[i]] = 1 }
          NF < 5 || $5 == "" || ($5 in keep)')
      fi
      if [ -z "$batch" ]; then
        :
      elif [ "$all" -eq 1 ]; then
        printf '%s\n' "$batch"
        return 0
      else
        matched=$(printf '%s\n' "$batch" | awk -F '\t' '$2 ~ /^(handoff|workspace-handoff|takeback|workspace-takeback|blocked|needs-decision|done|failed)$/')
        if [ -n "$matched" ]; then
          printf '%s\n' "$matched"
          return 0
        fi
      fi
    fi
    [ $((SECONDS - start)) -lt "$timeout" ] || break
    sleep 1
  done
  printf 'No actionable events within %s seconds.\n' "$timeout"
}

# Turn a scope argument into a comma list of sessions. 'session' is the
# controller's own session and 'server' is every session live right now; both
# are older spellings, resolved once into an explicit list.
normalize_scope() {
  local value=$1 own=$2 item out=
  case "$value" in
    session) value=$own ;;
    server) value=$(tmux_cmd list-sessions -F '#{session_name}' 2>/dev/null | paste -sd, -) ;;
  esac
  while IFS= read -r item; do
    [ -n "$item" ] || continue
    valid_id "$item" || die "invalid session name '$item' in scope"
    case ",$out," in *",$item,"*) continue ;; esac
    out=${out:+$out,}$item
  done <<< "$(printf '%s\n' "$value" | tr ',' '\n')"
  [ -n "$out" ] || die "a scope needs at least one session"
  printf '%s\n' "$out"
}

# Show or change which sessions a controller covers. One argument edits the
# calling controller: a list replaces its scope, +A adds and -A removes. Two
# arguments name the controller first. Scope is read at call time, so the change
# needs no restart.
cmd_scope() {
  ensure_home
  local id= value= meta current own new item
  case $# in
    0) id=$(caller_controller_id) || die "scope needs a controller id when the caller is not a controller; see 'ego list --controllers'" ;;
    1) value=$1
       id=$(caller_controller_id) || die "scope needs a controller id when the caller is not a controller; see 'ego list --controllers'" ;;
    2) id=$1; value=$2 ;;
    *) die "usage: ego scope [<controller-id>] [<session,...>|+<session>|-<session>]" ;;
  esac
  valid_id "$id" || die "invalid controller id '$id'"
  meta=$(controller_meta "$id") || die "unknown controller '$id'; see 'ego list --controllers'"
  current=$(controller_scope_list "$meta")
  own=$(meta_get "$meta" session)
  if [ -z "$value" ]; then
    if [ -n "$current" ]; then session_list_text "$current"; else printf 'every session\n'; fi
    return 0
  fi
  case "$value" in
    +*)
      [ -n "$current" ] || die "controller '$id' still covers every session; set an explicit list first"
      new=$(normalize_scope "$(printf '%s\n' "$current" | paste -sd, -),${value#+}" "$own")
      ;;
    -*)
      [ -n "$current" ] || die "controller '$id' still covers every session; set an explicit list first"
      new=
      while IFS= read -r item; do
        case ",${value#-}," in *",$item,"*) continue ;; esac
        new=${new:+$new,}$item
      done <<< "$current"
      new=$(normalize_scope "$new" "$own")
      ;;
    *) new=$(normalize_scope "$value" "$own") ;;
  esac
  meta_set "$meta" scope "$new"
  meta_set "$meta" updated_at "$(now)"
  append_event controller "$id" "scope=$new" "$own"
  printf 'controller %s now covers %s\n' "$id" "$(printf '%s' "$new" | sed 's/,/, /g')"
}

# Add a session the calling controller just created to its own scope, so it
# keeps reach over the workspace it made. A caller with no explicit list already
# covers every session.
add_session_to_caller_scope() {
  local session=$1 id meta current
  id=$(caller_controller_id) || return 0
  meta="$CONTROLLERS_DIR/$id/meta"
  current=$(controller_scope_list "$meta")
  [ -n "$current" ] || return 0
  ! in_session_list "$session" "$current" || return 0
  meta_set "$meta" scope "$(normalize_scope "$(printf '%s\n' "$current" | paste -sd, -),$session" "$(meta_get "$meta" session)")"
  meta_set "$meta" updated_at "$(now)"
  append_event controller "$id" "scope+=$session" "$session"
}

cmd_start() {
  local session= window=ego agent=claude scope= row pane launch prompt controller_dir guide id
  while [ $# -gt 0 ]; do
    case "$1" in
      --session) [ $# -ge 2 ] || die "--session requires a value"; session=$2; shift 2 ;;
      --window) [ $# -ge 2 ] || die "--window requires a value"; window=$2; shift 2 ;;
      --agent) [ $# -ge 2 ] || die "--agent requires a value"; agent=$2; shift 2 ;;
      --scope) [ $# -ge 2 ] || die "--scope requires a value"; scope=$2; shift 2 ;;
      *) die "unknown start option '$1'" ;;
    esac
  done
  launchable_agent "$agent" || die "--agent must be codex, claude, or kiro"
  command -v "$(agent_executable "$agent")" >/dev/null 2>&1 || die "$(agent_executable "$agent") is not installed"
  require_tmux
  ensure_home
  guide=$CONTROLLER_GUIDE
  [ -f "$guide" ] || guide="$REPO_ROOT/CONTROLLER.md"
  [ -f "$guide" ] || die "controller guide is missing; run 'ego install'"
  if [ -z "$session" ] && [ -n "${TMUX:-}" ]; then
    session=$(tmux_cmd display-message -p '#S')
  fi
  [ -n "$session" ] || die "run start inside tmux or pass --session"
  # The controller runs from its session's workspace root so its window matches
  # every other window in that session. The neutral state directory is only a
  # fallback for a session whose root cannot be resolved.
  controller_dir=$(resolve_session_root "$session" 2>/dev/null || true)
  [ -n "$controller_dir" ] && [ -d "$controller_dir" ] || controller_dir="$EGO_HOME/controller"
  # A controller covers its own session unless told otherwise. More sessions
  # are added explicitly, with --scope here or 'ego scope' later.
  scope=$(normalize_scope "${scope:-$session}" "$session")
  if inventory | awk -F '\t' -v s="$session" -v w="$window" '$1 == s && $2 == w { found=1 } END { exit !found }'; then
    die "tmux window $session:$window already exists"
  fi
  id=$(clean_id "$session--$window")
  tmux_cmd new-window -d -t "=$session:" -n "$window" -c "$controller_dir"
  row=$(resolve_target "$session:$window")
  IFS=$'\t' read -r _ _ _ pane _ <<< "$row"
  # Starting this controller must not disturb one already running, so both the
  # record and the launch script live under this controller's own id.
  record_controller "$id" "$session" "$window" "$pane" "$controller_dir" "$scope"
  enforce_controller_panes >/dev/null
  launch="$CONTROLLERS_DIR/$id/launch.sh"
  prompt="You are Sandro's Ego, controller $id. Read and follow $guide. Start by running $EGO_CLI_PATH context. Use $EGO_CLI_PATH for Ego commands."
  {
    printf '#!/bin/zsh\n'
    printf 'export EGO_HOME=%s\n' "$(shell_quote "$EGO_HOME")"
    printf 'export EGO_CONTROLLER_ID=%s\n' "$(shell_quote "$id")"
    launch_exec_line "$agent" "$controller_dir" "$prompt"
  } > "$launch"
  chmod 700 "$launch"
  tmux_cmd send-keys -t "$pane" "$(shell_quote "$launch")" Enter
  append_event controller "$id" "$session:$window scope=$scope" "$session"
  printf 'started Ego %s at %s:%s covering %s\n' "$id" "$session" "$window" "$(printf '%s' "$scope" | sed 's/,/, /g')"
}

command_name=${1:-help}
[ $# -eq 0 ] || shift
if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  command_usage "$command_name"
  exit 0
fi
# --any-session is accepted anywhere, so no command needs its own flag for the
# scope override. It is stripped before dispatch.
if [ $# -gt 0 ]; then
  ego_args=()
  for ego_arg in "$@"; do
    if [ "$ego_arg" = --any-session ]; then
      EGO_ANY_SESSION=1
    else
      ego_args+=("$ego_arg")
    fi
  done
  set -- ${ego_args[@]+"${ego_args[@]}"}
fi
case "$command_name" in
  help)
    if [ $# -gt 0 ]; then command_usage "$1"; else usage; fi
    ;;
  -h|--help) usage ;;
  install) cmd_install "$@" ;;
  init) cmd_init "$@" ;;
  scan) cmd_scan "$@" ;;
  list) cmd_list "$@" ;;
  controllers) cmd_controllers "$@" ;;
  scope) cmd_scope "$@" ;;
  promote) cmd_promote "$@" ;;
  workspaces) cmd_list --workspaces "$@" ;;
  context|status|session-start) cmd_context "$@" ;;
  retire) cmd_retire "$@" ;;
  purge) cmd_purge "$@" ;;
  # Older names for retire and purge.
  prune) cmd_retire --stale "$@" ;;
  archive-workspace)
    [ $# -eq 1 ] || die "archive-workspace requires one session"
    cmd_retire "$1:"
    ;;
  forget)
    forget_args=() forget_purge=0
    for forget_arg in "$@"; do
      if [ "$forget_arg" = --purge ]; then forget_purge=1; else forget_args+=("$forget_arg"); fi
    done
    if [ "$forget_purge" -eq 1 ]; then
      cmd_purge ${forget_args[@]+"${forget_args[@]}"}
    else
      cmd_retire ${forget_args[@]+"${forget_args[@]}"}
    fi
    ;;
  register) require_tmux; cmd_register "$@" ;;
  spawn) cmd_spawn "$@" ;;
  onboard) require_tmux; cmd_onboard "$@" ;;
  onboard-workspace) require_tmux; cmd_onboard_workspace "$@" ;;
  handoff) require_tmux; cmd_handoff "$@" ;;
  checkpoint) require_tmux; cmd_checkpoint "$@" ;;
  stow) require_tmux; cmd_stow "$@" ;;
  handoff-workspace) require_tmux; cmd_handoff_workspace "$@" ;;
  takeback-workspace) require_tmux; cmd_takeback_workspace "$@" ;;
  recover) cmd_recover "$@" ;;
  handback|takeback) cmd_takeback "$@" ;;
  offboard) require_tmux; cmd_offboard "$@" ;;
  peek) require_tmux; cmd_peek "$@" ;;
  send) require_tmux; cmd_send "$@" ;;
  press) require_tmux; cmd_press "$@" ;;
  inbox) cmd_inbox "$@" ;;
  ack) cmd_ack "$@" ;;
  report) cmd_report "$@" ;;
  watch) cmd_watch "$@" ;;
  start) cmd_start "$@" ;;
  *) usage >&2; die "unknown command '$command_name'" ;;
esac
